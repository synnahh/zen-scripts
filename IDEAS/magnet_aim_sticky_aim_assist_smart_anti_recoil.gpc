/*🎯🧲 MAGNET AIM: Sticky Assist + Smart Anti-Recoil 🔥🎯


   MENU        L2 + OPTIONS
   NAVIGATE    D-Pad UP / DOWN
   SELECT      CROSS
   ADJUST      D-Pad LEFT / RIGHT
   BACK        CIRCLE


⚡ PLUG & PLAY: Already tuned, zero setup. 🎮

🌀 ORBITAL AIM ASSIST: 👍 25 LIKES TO UNLOCK 🚀
A brand new assist mode already in the works: instead of the classic
square pattern, the stick traces a smooth circular orbit around the
target: no corners, no snap, pure adhesion while tracking. Hit 25
likes and it drops. 💧

🎯 Sticky Aim Assist
Continuous micro-movement applied to the right stick while you aim
or fire, increasing aim adhesion and making tracking on a moving
target far more stable.
  • Adjustable SIZE: how wide the movement is
  • Adjustable DELAY: how fast it cycles
  • LEFT STICK option: adds the same micro-movement to your
    movement stick for extra strafe adhesion

🔫 Smart Anti-Recoil
Vertical compensation that behaves like a real player, not a robot:
  • 📉 Fades over time: full power on the first shots, 75% after
    half a second, 50% after one second of sustained fire. Release
    the trigger and it resets to full.
  • 🖐️ Gets out of your way: reads your raw stick input and backs
    off the more you turn. Flick the stick and it disappears
    completely, so it never fights your own aim.
  • Only active while aiming AND firing.

🎛️ Animated OLED Menu: L2 + OPTIONS
Everything adjustable from the controller, no PC needed.
  • 📡 Radar boot sequence
  • 🎯 Live HUD with breathing reticle
  • 🎚️ Animated sliders and switches
  • 💾 Settings saved to the Zen

😴 Idle Shooting Range
Leave it alone and the screen comes alive: targets run across the
display, the reticle hunts them down, locks on and takes the shot.
Also protects your OLED from burn-in.

👍 25 LIKES = ORBITAL AIM ASSIST DROPS 🌀 */

define ST_BOOT =  0;
define ST_HOME = 1; 
define ST_MENU = 2;
define ST_MOD  = 3;

define FRAME_MS    = 33; 

define IDLE_FRAMES = 20;
define BOOT_END    = 2400;
define HIT_CHANCE  = 50; 
define LOCK_MS     = 320; 
define FIRE_MS     = 190;
define DEAD_MS     = 1350;

define FP = 16;


define ROW_H    = 13;
define LIST_Y   = 11;
define FOOT_Y   = 51;

define P_AIM_ON   = 0;
define P_AIM_SIZE =  1;
define P_AIM_WAIT = 2;
define P_AIM_LS   = 3;
define P_AR_ON    = 4;
define P_AR_VERT  = 5;
define N_PARAMS   = 6;

define N_MODS     =  2;
define N_ITEMS    = 3;

define PT_TOGGLE  = 0;
define PT_VALUE   = 1;

define NPART      = 10;
define RUN_NONE   = 0; 
define RUN_LIVE   = 1;
define RUN_DEAD   = 2;

const int8 SIN64[] = {
       0,   10,   20,   29,   38,   47,   56,   63,
      71,   77,   83,   88,   92,   96,   98,  100,
     100,   100,   98,   96,   92,   88,   83,   77,
      71,   63,   56,   47,   38,   29,   20,   10,
       0,  -10,  -20,  -29,  -38,  -47,  -56,  -63,
     -71,  -77,  -83,  -88,  -92,  -96,  -98, -100,
    -100, -100,  -98,  -96,  -92,  -88,  -83,  -77,
     -71,  -63,  -56,  -47,  -38,  -29,  -20,  -10
};

const int8 PAR_FIRST[] = { P_AIM_ON,P_AR_ON };
const int8 PAR_COUNT[] = { 4,  2 };

const int8 PAR_TYPE[]  = { PT_TOGGLE, PT_VALUE, PT_VALUE, PT_TOGGLE, PT_TOGGLE, PT_VALUE };
const int8 PAR_MIN[]   = { 0,  1,  1, 0, 0,   0 };
const int8 PAR_MAX[]   = { 1,60,40,1,1,100 };
const int8 PAR_STEP[]  = { 1,   1,  1, 1, 1,   1 };

const int8 PAR_DEF[]   = {   1,  20,  10,  1,   1,  40 };

const int8 AIM_PAT[]   = { 10,0,0,10,-10,0,0,-10 }; 
define AIM_PAT_SIZE = 8;
define AIM_LS_SIZE  = 20;

define AR_SOFT   = 25;
define AR_CUTOFF = 70;

define AR_FADE_MS  = 1000;
define AR_FADE_END = 50; 

define CFG_MAGIC = 101;

const string S_MENU    = "MOD MENU";
const string S_SAVE    = "SAVE & EXIT";
const string S_ON      = "ON";
const string S_OFF     = "OFF";
const string S_AIM     = "AIM ASSIST";
const string S_AR      = "ANTI-RECOIL";
const string S_ENABLED = "ENABLED";
const string S_SIZE    = "SIZE";
const string S_DELAY   = "DELAY";
const string S_LSTICK  = "LEFT STICK";
const string S_VERT    = "VERTICAL";
const string S_HINT    = "L2+OPTIONS > MENU";
const string S_HINT_M  = "X ENTER    O EXIT";
const string S_HINT_P  = "<> CHANGE  O BACK";

int par[N_PARAMS];

int ui_state, ui_frame, dt, acc;
int boot_t, home_t, idle_f, scan_y, typed, type_t;
int glitch_t;

int menu_sel, mod_idx, par_sel;
int sel_fp,sel_tfp,scroll_fp,scroll_tfp;
int ps_fp, ps_tfp, pscroll_fp, pscroll_tfp;

int pat_speed,  stick_adj, ar_v, ar_in, ar_f, ar_t, ar_ramp;
int anim_fp[N_PARAMS];

int run_state,  run_x, run_y, run_dir, run_leg, run_leg_t;
int spawn_t,  lock_t, fire_t, dead_t, miss_t, boost_t;
int cross_x,cross_y,cross_tx,cross_ty;
int pa_x[NPART], pa_y[NPART], pa_vx[NPART], pa_vy[NPART], pa_life[NPART], pa_gnd[NPART];


int in_l2, in_opt, in_up, in_dn, in_lf, in_rg, in_cr, in_ci;
int lst_opt, lst_up, lst_dn, lst_lf, lst_rg, lst_cr, lst_ci; 
int ev_opt, ev_up, ev_dn, ev_lf, ev_rg, ev_cr, ev_ci;

int i_ring, i_ray, i_row, i_part, i_cell, i_ang;
int tmp_x, tmp_y, tmp_r, tmp_v;
int sweep_a;
int ez_d;
int pidx;

init {

    if(get_pvar(SPVAR_7,  0, 30000, 0) == CFG_MAGIC) {
       par[P_AIM_ON]   = get_pvar(SPVAR_1,  0,   1, PAR_DEF[P_AIM_ON]);
        par[P_AIM_SIZE] = get_pvar(SPVAR_2, 1,  60, PAR_DEF[P_AIM_SIZE]);
        par[P_AIM_WAIT] =  get_pvar(SPVAR_3,1, 40,PAR_DEF[P_AIM_WAIT]);
        par[P_AIM_LS]   = get_pvar(SPVAR_4,  0,   1, PAR_DEF[P_AIM_LS]);
        par[P_AR_ON]    = get_pvar(SPVAR_5,  0,   1, PAR_DEF[P_AR_ON]);
        par[P_AR_VERT]  = get_pvar(SPVAR_6, 0, 100, PAR_DEF[P_AR_VERT]);
    } else {
        for (i_cell = 0; i_cell < N_PARAMS; i_cell++) par[i_cell] = PAR_DEF[i_cell];
        set_pvar(SPVAR_7, CFG_MAGIC);
        save_settings();
    }

     for(i_cell = 0; i_cell < N_PARAMS; i_cell++) anim_fp[i_cell] = par[i_cell] * FP;
    for(i_part = 0; i_part < NPART; i_part++) pa_life[i_part] = 0;

    ui_state = ST_BOOT;
    boot_t = 0; 
   scan_y = -25;
    spawn_t = 600;
     run_state = RUN_NONE; 
    cross_x =  64 * FP;  cross_tx = cross_x;
    cross_y = 30 * FP;  cross_ty = cross_y;
}

main {
    read_inputs();

     if(ui_state == ST_MENU || ui_state == ST_MOD) block_all_inputs();
   else run_mods();

    handle_input(); 

    acc =  acc + get_rtime();
    if (acc >= FRAME_MS) {
        dt = acc; 
        if (dt > 100) dt = 100;
        acc = 0;
       ui_frame++;
        draw_frame();
   }
}

function read_inputs() {

    in_l2  = get_ival(PS4_L2);
    in_opt = get_ival(PS4_OPTIONS);
    in_up  = get_ival(PS4_UP);
    in_dn  = get_ival(PS4_DOWN);
    in_lf  = get_ival(PS4_LEFT);
    in_rg  = get_ival(PS4_RIGHT);
    in_cr  = get_ival(PS4_CROSS);
    in_ci  = get_ival(PS4_CIRCLE);

    ev_opt = 0;  if (in_opt && !lst_opt) ev_opt = 1;   lst_opt = in_opt;
    ev_up  = 0;  if (in_up  && !lst_up)  ev_up  = 1;   lst_up  = in_up;
    ev_dn  =  0;  if (in_dn  && !lst_dn)  ev_dn  = 1;   lst_dn  = in_dn;
     ev_lf  = 0;  if(in_lf  && !lst_lf)  ev_lf  = 1;   lst_lf  = in_lf;
    ev_rg  = 0;  if (in_rg  && !lst_rg)  ev_rg  = 1;   lst_rg  = in_rg;
    ev_cr  = 0;  if(in_cr  && !lst_cr)  ev_cr  = 1;   lst_cr  = in_cr;
    ev_ci  =  0;  if (in_ci  && !lst_ci)  ev_ci  = 1;   lst_ci  = in_ci;
}

function handle_input() {

     if (ev_opt && in_l2 && ui_state != ST_BOOT) {
        if (ui_state == ST_HOME) open_menu();
         else close_menu();

    } else if(ui_state == ST_MENU){
        if (ev_up) { menu_sel = menu_sel - 1;  if (menu_sel < 0) menu_sel = N_ITEMS - 1;  sync_menu(); }
        if (ev_dn) { menu_sel = menu_sel + 1;  if (menu_sel >= N_ITEMS) menu_sel = 0;     sync_menu(); }
       if (ev_cr || ev_rg) {
            if (menu_sel >= N_MODS) close_menu();
            else {
                mod_idx = menu_sel;
                par_sel = 0;  ps_fp = 0;  ps_tfp = 0;  pscroll_fp = 0;  pscroll_tfp = 0;
                ui_state = ST_MOD;  glitch_t = 120;
            }
        }
        if (ev_ci) close_menu();

    } else if(ui_state == ST_MOD) {
        if (ev_up) { par_sel = par_sel - 1;  if (par_sel < 0) par_sel = PAR_COUNT[mod_idx] - 1;  sync_par(); }
        if(ev_dn) { par_sel = par_sel + 1;  if(par_sel >= PAR_COUNT[mod_idx]) par_sel = 0;     sync_par(); }

        pidx = PAR_FIRST[mod_idx] + par_sel;

        if(PAR_TYPE[pidx] == PT_TOGGLE) {
            if (ev_cr) { if (par[pidx]) par[pidx] = 0; else par[pidx] = 1; }
            if (ev_lf) { par[pidx] = 0; }
            if(ev_rg) { par[pidx] = 1; }
        } else {
            if (ev_lf) { par[pidx] = par[pidx] - PAR_STEP[pidx];  if (par[pidx] < PAR_MIN[pidx]) par[pidx] = PAR_MIN[pidx]; }
            if (ev_rg) { par[pidx] = par[pidx] + PAR_STEP[pidx];  if (par[pidx] > PAR_MAX[pidx]) par[pidx] = PAR_MAX[pidx]; }
        }
       if(ev_ci) { ui_state = ST_MENU; glitch_t = 120; }
     }
}

function open_menu() {
    ui_state = ST_MENU;
    menu_sel = 0;
    sync_menu();
    sel_fp =  sel_tfp;  scroll_fp = scroll_tfp;
    glitch_t =  140;
}

function close_menu() {
    save_settings();
   ui_state = ST_HOME;
    home_t = 600;  typed = 17;  type_t = 1000;  idle_f = 0;
    glitch_t = 140;
}

function sync_menu(){
    sel_tfp = menu_sel * ROW_H * FP; 
    tmp_v = menu_sel - 2; 
    if(tmp_v < 0) tmp_v = 0;
    if(tmp_v > N_ITEMS - 3) tmp_v = N_ITEMS - 3;
   if (tmp_v < 0) tmp_v = 0;
    scroll_tfp = tmp_v * ROW_H * FP;
}

function sync_par() {
    ps_tfp = par_sel * ROW_H * FP;
    tmp_v = par_sel - 2;
    if (tmp_v < 0) tmp_v = 0;
   if (tmp_v > PAR_COUNT[mod_idx] - 3) tmp_v = PAR_COUNT[mod_idx] - 3;
    if (tmp_v < 0) tmp_v = 0; 
    pscroll_tfp = tmp_v * ROW_H * FP;
}

function save_settings() {
    set_pvar(SPVAR_1, par[P_AIM_ON]); 
   set_pvar(SPVAR_2, par[P_AIM_SIZE]);
   set_pvar(SPVAR_3, par[P_AIM_WAIT]);
    set_pvar(SPVAR_4, par[P_AIM_LS]);
     set_pvar(SPVAR_5, par[P_AR_ON]);
    set_pvar(SPVAR_6,  par[P_AR_VERT]);
}

function sn(a) { return SIN64[((a % 64) + 64) % 64]; }
function cs(a) { return SIN64[(((a + 16) % 64) + 64) % 64]; }

function ease(cur, tgt, k) {
    if (cur == tgt) return tgt; 
    ez_d = (tgt - cur) / k;
    if (ez_d == 0) { if (tgt > cur) return cur + 1; else return cur - 1; }
     return cur + ez_d;
}

function hud_frame(len, ins) {
    line_oled(ins,  ins, ins + len, ins, 1, 1);
    line_oled(ins, ins, ins, ins + len, 1, 1);
    line_oled(127 - ins - len,ins,127 - ins,ins,1,1);
    line_oled(127 - ins, ins, 127 - ins, ins + len, 1, 1);
    line_oled(ins, 63 - ins - len, ins, 63 - ins, 1, 1);
     line_oled(ins, 63 - ins, ins + len, 63 - ins, 1, 1);
    line_oled(127 - ins,63 - ins - len,127 - ins,63 - ins,1,1);
   line_oled(127 - ins - len, 63 - ins, 127 - ins, 63 - ins, 1, 1);
}

function ring_dotted(cx, cy, r, step) {
    for(i_ring = 0; i_ring < 64; i_ring += step)
         pixel_oled(cx + cs(i_ring) * r / 100, cy + sn(i_ring) * r / 100, 1);
}

function ray(cx, cy, ang, r0, r1, skip) {
    for (i_ray =  r0; i_ray <= r1; i_ray++) {
        if (skip <= 1 || (i_ray % skip) == 0)
            pixel_oled(cx + cs(ang) * i_ray / 100, cy + sn(ang) * i_ray / 100, 1);
    }
}

function draw_num(x, y, v, col) {
    putc_oled(1,32);  putc_oled(2,32);  putc_oled(3,32);
   if (v >= 100) {
        putc_oled(1, 48 + (v / 100));
        putc_oled(2, 48 + ((v / 10) % 10));
        putc_oled(3, 48 + (v % 10));
    } else if(v >= 10){
        putc_oled(2, 48 + (v / 10));
        putc_oled(3, 48 + (v % 10));
    } else {
        putc_oled(3, 48 + v);
    }
    puts_oled(x, y, OLED_FONT_SMALL, 3, col);
}

function draw_frame() {
     cls_oled(0);

    if (ui_state == ST_BOOT) draw_boot();
    else if (ui_state == ST_HOME) draw_home();
    else if (ui_state == ST_MENU) { idle_f = 0; draw_menu(); }
    else { idle_f = 0; draw_mod(); }

    if(glitch_t > 0) { glitch_t = glitch_t - dt; draw_glitch(); }
}

function draw_glitch() {
    for (i_row = 0; i_row < 3; i_row++) {
        tmp_y = random(0,58);
        rect_oled(0, tmp_y, 128, random(2, 6), 1, i_row % 2);
   }
    for (i_part = 0; i_part < 40; i_part++)
         pixel_oled(random(0,127),random(0,63),1);
}

function draw_boot(){
    boot_t = boot_t + dt;

    if (boot_t < 1500) {


       tmp_r =  boot_t / 10;
        if (tmp_r > 30) tmp_r = 30;

        ring_dotted(64, 32, tmp_r, 4);
        if (tmp_r > 14) ring_dotted(64,  32, 14, 3);
        if(tmp_r > 22) ring_dotted(64, 32, 22, 3);
        line_oled(32,  32, 96, 32, 1, 1);
        line_oled(64,  0, 64, 63, 1, 1);

        sweep_a = boot_t * 2 / 33;
        for (i_ang =  0; i_ang < 5; i_ang++) {
            if (i_ang == 0) ray(64, 32, sweep_a, 2, tmp_r, 1);
            else ray(64,  32, sweep_a - i_ang - i_ang, 2, tmp_r, i_ang + 1);
        }

        draw_blip(10, 22, sweep_a);
        draw_blip(25,  14, sweep_a);
        draw_blip(41,28,sweep_a);
        draw_blip(55,19,sweep_a);

    } else if (boot_t < 1800) {

       tmp_v = (1800 - boot_t);
        ring_dotted(64, 32, 30 * tmp_v / 300, 3);
        ring_dotted(64, 32, 18 * tmp_v / 300, 2);
        tmp_r = 6 - (6 * tmp_v / 300);
        if (tmp_r < 1) tmp_r = 1;
        circle_oled(64, 32, tmp_r, 1, 1);

    } else {

        tmp_v = (boot_t - 1800) * 2 / 11;
         if (tmp_v > 100) tmp_v = 100;
       tmp_r = 100 - ((100 - tmp_v) * (100 - tmp_v) / 100);
        hud_frame(9, 20 - (18 * tmp_r / 100));

        if(tmp_v > 45) {
            tmp_r = 3 + ((tmp_v - 45) * 7 / 55);
             circle_oled(64, 32, tmp_r, 0, 1);
            line_oled(64 - tmp_r - 4,32,64 - tmp_r - 1,32,1,1);
             line_oled(64 + tmp_r + 1, 32, 64 + tmp_r + 4, 32, 1, 1);
            line_oled(64, 32 - tmp_r - 4, 64, 32 - tmp_r - 1, 1, 1); 
           line_oled(64, 32 + tmp_r + 1, 64, 32 + tmp_r + 4, 1, 1);
        }
        if (boot_t > BOOT_END) { ui_state = ST_HOME; home_t = 0; typed = 0; type_t = 0; idle_f = 0; }
    }
}

function draw_blip(ang, r, sweep){
    tmp_x = ((sweep % 64) - ang + 64) % 64;
     if (tmp_x < 6){
       tmp_y = 32 + sn(ang) * r / 100;
        tmp_v = 64 + cs(ang) * r / 100;
        rect_oled(tmp_v,  tmp_y, 2, 2, 1, 1);
        if (tmp_x < 2) circle_oled(tmp_v,  tmp_y, 4, 0, 1);
    }
}

function draw_home() {
     home_t = home_t + dt;
    if (home_t > 20480) home_t =  home_t - 20480;
    idle_f++; 

     hud_frame(9, 2); 

    if(idle_f > IDLE_FRAMES) {
        update_idle();
       draw_idle_scene(); 
        tmp_x =  cross_x / FP;
        tmp_y = cross_y / FP;
    } else {
        cross_x = 64 * FP;  cross_tx = cross_x;
        cross_y = 30 * FP;  cross_ty = cross_y; 
        run_state = RUN_NONE;  spawn_t = 600;  lock_t = 0;  fire_t = 0;  miss_t = 0;
        for(i_part = 0; i_part < NPART; i_part++) pa_life[i_part] = 0;
        tmp_x = 64;
        tmp_y = 30;
    }

    tmp_r = 9;
     if (idle_f <= IDLE_FRAMES) tmp_r =  9 + (sn(home_t / 40) * 2 / 100);
    circle_oled(tmp_x,  tmp_y, tmp_r, 0, 1);
     line_oled(tmp_x - tmp_r - 5,tmp_y,tmp_x - tmp_r - 2,tmp_y,1,1);
   line_oled(tmp_x + tmp_r + 2, tmp_y, tmp_x + tmp_r + 5, tmp_y, 1, 1);
    line_oled(tmp_x, tmp_y - tmp_r - 5, tmp_x, tmp_y - tmp_r - 2, 1, 1);
    line_oled(tmp_x, tmp_y + tmp_r + 2, tmp_x, tmp_y + tmp_r + 5, 1, 1);
    if(idle_f <= IDLE_FRAMES){

        line_oled(tmp_x - 2, tmp_y, tmp_x + 2, tmp_y, 1, 1);
        line_oled(tmp_x, tmp_y - 2, tmp_x, tmp_y + 2, 1, 1);
        ring_dotted(tmp_x,  tmp_y, 16, 6);
    }

    rect_oled(0, 50, 128, 14, 0, 1);
    if (typed < 17) {
        type_t = type_t + dt; 
        typed = type_t * 22 / 1000;
        if(typed > 17) typed = 17;
   }
    print(4,52,OLED_FONT_SMALL,1,S_HINT[0]);
    if (typed < 17){

        tmp_v = 4 + typed * OLED_FONT_SMALL_WIDTH;
        rect_oled(tmp_v,52,123 - tmp_v,10,1,0);
        if ((ui_frame / 4) % 2) rect_oled(tmp_v, 53, 5, 8, 1, 1);
    }

    scan_y = scan_y + (dt * 60 / 1000);
    if (scan_y > 90) scan_y = -25;
    if(scan_y >= 0 && scan_y < 50) {
        line_oled(0, scan_y, 127, scan_y, 1, 1);
        for (i_row = 0; i_row < 128; i_row += 3) {
            pixel_oled(i_row, scan_y - 2, 1);
            pixel_oled(i_row + 1, scan_y + 2, 1);
        }
    }
}

function update_idle() {

   for (i_part = 0; i_part < NPART; i_part++) {
        if (pa_life[i_part] > 0) {
            if (pa_y[i_part] < pa_gnd[i_part] * FP) {
                pa_x[i_part] = pa_x[i_part] + (pa_vx[i_part] * dt / 33);
                pa_y[i_part] = pa_y[i_part] + (pa_vy[i_part] * dt / 33);
                pa_vy[i_part] = pa_vy[i_part] + 4;
            } else {
                pa_y[i_part] = pa_gnd[i_part] * FP;
                pa_vx[i_part] = 0;
                 pa_vy[i_part] = 0; 
            }
            pa_life[i_part] = pa_life[i_part] - dt;
        }
    }
    if (fire_t > 0) fire_t = fire_t - dt;
    if (miss_t > 0) miss_t = miss_t - dt;

    if(run_state == RUN_DEAD) {
        dead_t = dead_t + dt;
        cross_tx = run_x;
        cross_ty = (run_y - 7) * FP;
         if (dead_t > DEAD_MS) { run_state = RUN_NONE; spawn_t = random(500,  1300); }

     } else if (run_state == RUN_LIVE) {
        if(boost_t > 0) { boost_t = boost_t - dt;  run_x = run_x + (run_dir * 42 * dt / 33); }
        else run_x = run_x + (run_dir * 26 * dt / 33);

        run_leg_t =  run_leg_t + dt;
        if (run_leg_t > 110) { run_leg_t = 0;  if (run_leg) run_leg = 0; else run_leg = 1; }

        if (run_x < -14 * FP || run_x > 142 * FP) { run_state = RUN_NONE; lock_t = 0; spawn_t = random(400, 1200); }

         cross_tx = run_x + (run_dir * 3 * FP);
        if (cross_tx < 14 * FP) cross_tx = 14 * FP;
        if(cross_tx > 113 * FP) cross_tx = 113 * FP;
        cross_ty = (run_y - 7) * FP;


        if (miss_t <= 0 && run_x > 20 * FP && run_x < 107 * FP && abs(cross_x - cross_tx) < 8 * FP && abs(cross_y - cross_ty) < 8 * FP) {
             lock_t = lock_t + dt;
            if (lock_t > LOCK_MS) shoot();
        } else {
            lock_t = lock_t - dt;
            if (lock_t < 0) lock_t = 0;
        }

    } else {
        spawn_t = spawn_t - dt;
        cross_tx = 64 * FP;
        cross_ty =  30 * FP;
         if (spawn_t <= 0) spawn_runner();
    }

    cross_x = ease(cross_x, cross_tx, 3);
   cross_y = ease(cross_y, cross_ty, 3);
}

function spawn_runner() {
   if (random(0,1)) run_dir = 1; else run_dir = -1;
    if (run_dir > 0) run_x = -10 * FP; else run_x = 138 * FP;
    run_y = random(24, 42);
    run_state = RUN_LIVE;
    run_leg = 0;  lock_t = 0;  dead_t = 0;  miss_t = 0;  boost_t = 0;
}

function shoot() {
    fire_t = FIRE_MS;
    lock_t = 0;

     if(random(0,99) < HIT_CHANCE){

        run_state = RUN_DEAD;
        dead_t = 0;
        for(i_part = 0; i_part < NPART; i_part++) {
            pa_x[i_part]  = run_x;
            pa_y[i_part]  = (run_y - 6 - ((i_part % 3) * 2)) * FP;
            pa_vx[i_part] = random(-32, 32);
           pa_vy[i_part] = random(-30,  -4);
             pa_gnd[i_part] = run_y + 1 + random(0, 1);
            pa_life[i_part] =  1250;
         }
     } else {

        miss_t = 520; 
        boost_t = 550;
     }
}

function draw_idle_scene() {
    tmp_x = run_x / FP;

    if (run_state == RUN_LIVE && tmp_x > 5 && tmp_x < 122) {
       draw_runner(tmp_x,run_y,run_leg,run_dir);
        if(lock_t > 0 && tmp_x > 19 && tmp_x < 108) {
            tmp_v = lock_t * 5 / LOCK_MS;  if (tmp_v > 5) tmp_v = 5;
            tmp_r =  lock_t * 3 / LOCK_MS;  if(tmp_r > 3) tmp_r = 3;
            draw_lock(tmp_x, run_y - 7, 16 - tmp_v, 10 - tmp_r);
        }
        if (miss_t > 0 && (ui_frame % 2) && tmp_x > 21 && tmp_x < 106) draw_lock(tmp_x, run_y - 7, 20, 11);
    }
    if (run_state == RUN_DEAD && tmp_x > 6 && tmp_x < 121) draw_corpse(tmp_x, run_y, dead_t);

    for (i_part = 0; i_part < NPART; i_part++) {
        if(pa_life[i_part] > 0) {
            tmp_v = pa_x[i_part] / FP;
            tmp_y = pa_y[i_part] / FP;
            if (tmp_v >= 0 && tmp_v < 128 && tmp_y >= 0 && tmp_y < 64) pixel_oled(tmp_v, tmp_y, 1);
        }
    }

    if (fire_t > 0) {

        tmp_v = cross_x / FP;
        tmp_y = cross_y / FP;
        tmp_r = (FIRE_MS - fire_t) * 9 / FIRE_MS;
        circle_oled(tmp_v, tmp_y, tmp_r + 2, 0, 1);
        for (i_ang = 0; i_ang < 64; i_ang += 8)
            line_oled(tmp_v + cs(i_ang) * (tmp_r + 3) / 100,  tmp_y + sn(i_ang) * (tmp_r + 3) / 100,
                      tmp_v + cs(i_ang) * (tmp_r + 5) / 100,tmp_y + sn(i_ang) * (tmp_r + 5) / 100,1,1);
     }
}

function draw_runner(x,  gy, leg, dir) {
    rect_oled(x - 1, gy - 11, 3, 3, 1, 1);
    line_oled(x,  gy - 8, x, gy - 4, 1, 1);
     if (leg) {
        line_oled(x, gy - 7, x + dir * 4, gy - 9, 1, 1);
        line_oled(x,  gy - 7, x - dir * 3, gy - 5, 1, 1);
        line_oled(x, gy - 4, x + dir * 4, gy - 1, 1, 1);
        line_oled(x, gy - 4, x - dir * 3, gy, 1, 1);
    } else {
        line_oled(x,gy - 7,x + dir * 4,gy - 5,1,1);
        line_oled(x, gy - 7, x - dir * 3, gy - 9, 1, 1);
        line_oled(x,  gy - 4, x + dir * 2, gy, 1, 1);
         line_oled(x, gy - 4, x - dir * 4, gy - 1, 1, 1); 
    }
}


function draw_lock(x, y, rx, ry) {
    line_oled(x - rx, y - ry, x - rx + 3, y - ry, 1, 1);
    line_oled(x - rx, y - ry, x - rx, y - ry + 3, 1, 1);
    line_oled(x + rx - 3, y - ry, x + rx, y - ry, 1, 1);
    line_oled(x + rx, y - ry, x + rx, y - ry + 3, 1, 1);
    line_oled(x - rx, y + ry - 3, x - rx, y + ry, 1, 1);
    line_oled(x - rx,y + ry,x - rx + 3,y + ry,1,1);
    line_oled(x + rx, y + ry - 3, x + rx, y + ry, 1, 1);
    line_oled(x + rx - 3, y + ry, x + rx, y + ry, 1, 1);
}

function draw_corpse(x,  gy, t) {
    if(t < 150) {
        rect_oled(x - 1, gy - 8, 3, 3, 1, 1);
        line_oled(x, gy - 5, x, gy - 2, 1, 1);
        line_oled(x, gy - 2, x - 3, gy, 1, 1);
        line_oled(x, gy - 2, x + 3, gy, 1, 1);
        line_oled(x, gy - 5, x - 4, gy - 3, 1, 1);
        line_oled(x, gy - 5, x + 4, gy - 2, 1, 1);
    } else if (t < 330) {
        rect_oled(x - 5, gy - 5, 3, 3, 1, 1);
        line_oled(x - 3, gy - 3, x + 2, gy, 1, 1);
        line_oled(x + 2, gy, x + 5, gy - 1, 1, 1);
        line_oled(x - 2,  gy - 2, x + 1, gy, 1, 1);
    } else {
        for (i_cell = -6; i_cell <= 5; i_cell++) {
            if(t < 1000 || (i_cell % 2) == 0) {
                 pixel_oled(x + i_cell, gy, 1);
                if(i_cell > -4 && i_cell < 3) pixel_oled(x + i_cell, gy - 1, 1);
            }
        }
        if (t < 1000) rect_oled(x - 6, gy - 3, 3, 3, 1, 1);
   }
}

function draw_menu() {
    sel_fp = ease(sel_fp, sel_tfp, 3);
    scroll_fp = ease(scroll_fp, scroll_tfp, 3);

    for (i_row = 0; i_row < N_ITEMS; i_row++) {
        tmp_y = LIST_Y + (i_row * ROW_H) - (scroll_fp / FP);
        if (tmp_y > -2 && tmp_y < 52) {
            if (i_row >= N_MODS) {
                print(10, tmp_y + 1, OLED_FONT_SMALL, 1, S_SAVE[0]);
           } else {
                draw_mod_name(i_row, 10, tmp_y + 1, 1);
                tmp_v = par[PAR_FIRST[i_row]]; 
                if (tmp_v) {
                    rect_oled(100,tmp_y + 1,24,11,1,1); 
                    print(103, tmp_y + 1, OLED_FONT_SMALL, 0, S_ON[0]);
                } else {
                    print(103, tmp_y + 1, OLED_FONT_SMALL, 1, S_OFF[0]); 
               }
            }
        }
    }


    tmp_y = LIST_Y + (sel_fp / FP) - (scroll_fp / FP);
    putc_oled(1,  62);
     puts_oled(1, tmp_y + 1, OLED_FONT_SMALL, 1, 1);
    rect_oled(8, tmp_y, 116, ROW_H, 0, 1);
    if((ui_frame / 8) % 2) rect_oled(9,  tmp_y + 1, 114, ROW_H - 2, 0, 1);

    rect_oled(0, FOOT_Y, 128, 13, 1, 0);
    rect_oled(0, 0, 128, LIST_Y, 1, 1);
    print(3, 0, OLED_FONT_SMALL, 0, S_MENU[0]);
     draw_count(103, 0);

     line_oled(0, FOOT_Y, 127, FOOT_Y, 1, 1); 
    print(3, 53, OLED_FONT_SMALL, 1, S_HINT_M[0]);
}

function draw_count(x, y) {
    tmp_v = 0;
    for(i_cell = 0; i_cell < N_MODS; i_cell++) if (par[PAR_FIRST[i_cell]]) tmp_v++; 
    putc_oled(1, 48 + tmp_v); 
     putc_oled(2, 47);
    putc_oled(3, 48 + N_MODS);
    puts_oled(x, y, OLED_FONT_SMALL, 3, 0);
}

function draw_mod_name(idx,x,y,col) {
    if (idx == 0) print(x, y, OLED_FONT_SMALL, col, S_AIM[0]);
    else print(x, y, OLED_FONT_SMALL, col, S_AR[0]);
}

function draw_par_name(idx, x, y, col) {
    if (idx == P_AIM_ON || idx == P_AR_ON) print(x, y, OLED_FONT_SMALL, col, S_ENABLED[0]);
    else if (idx == P_AIM_SIZE) print(x, y, OLED_FONT_SMALL, col, S_SIZE[0]);
   else if (idx == P_AIM_WAIT) print(x, y, OLED_FONT_SMALL, col, S_DELAY[0]);
    else if (idx == P_AIM_LS)   print(x,y,OLED_FONT_SMALL,col,S_LSTICK[0]);
    else print(x, y, OLED_FONT_SMALL, col, S_VERT[0]);
}

function draw_mod() {
    ps_fp = ease(ps_fp, ps_tfp, 3);
    pscroll_fp = ease(pscroll_fp, pscroll_tfp, 3);

    for(i_row = 0; i_row < PAR_COUNT[mod_idx]; i_row++){
        pidx = PAR_FIRST[mod_idx] + i_row;
        tmp_y =  12 + (i_row * ROW_H) - (pscroll_fp / FP);

        anim_fp[pidx] = ease(anim_fp[pidx], par[pidx] * FP, 4); 

        if (tmp_y > -2 && tmp_y < 51) {
            draw_par_name(pidx, 10, tmp_y, 1);

            if (PAR_TYPE[pidx] == PT_TOGGLE) {

                rect_oled(94, tmp_y + 1, 26, 9, 0, 1);
                rect_oled(96 + (anim_fp[pidx] * 13 / FP), tmp_y + 2, 11, 7, 1, 1);
                 if(par[pidx] && ((ui_frame / 4) % 2)) rect_oled(93, tmp_y, 28, 11, 0, 1);
            } else {

                rect_oled(68, tmp_y + 2, 32, 7, 0, 1);
                tmp_v = (anim_fp[pidx] + (FP / 2)) / FP;
                tmp_r =  tmp_v * 30 / PAR_MAX[pidx];
                if(tmp_r > 30) tmp_r =  30;
                if(tmp_r > 0) rect_oled(69, tmp_y + 3, tmp_r, 5, 1, 1);
                draw_num(103, tmp_y, tmp_v, 1);
            }
       }
    }

    tmp_y =  12 + (ps_fp / FP) - (pscroll_fp / FP);
    putc_oled(1, 62);
    puts_oled(1,tmp_y,OLED_FONT_SMALL,1,1); 
    line_oled(9, tmp_y + 11, 60, tmp_y + 11, 1, 1);

     if(PAR_COUNT[mod_idx] > 3) {
        line_oled(126, 12, 126, 50, 1, 1);
        rect_oled(125, 12 + (par_sel * 29 / (PAR_COUNT[mod_idx] - 1)), 3, 10, 1, 1);
    }

    rect_oled(0, FOOT_Y, 128, 13, 1, 0);
   rect_oled(0, 0, 128, LIST_Y, 1, 1);
     draw_mod_name(mod_idx, 3, 0, 0);
   if (par[PAR_FIRST[mod_idx]]) print(113, 0, OLED_FONT_SMALL, 0, S_ON[0]);

    line_oled(0,FOOT_Y,127,FOOT_Y,1,1);
    print(3, 53, OLED_FONT_SMALL, 1, S_HINT_P[0]); 
}

function run_mods(){

    if(par[P_AIM_ON]) aim_assist();
    if (par[P_AR_ON]) anti_recoil();

}

function anti_recoil() {
   if(get_val(PS4_L2) && get_val(PS4_R2)){

        if (ar_t < AR_FADE_MS) ar_t = ar_t + get_rtime();
        if (ar_t > AR_FADE_MS) ar_t = AR_FADE_MS;

        ar_ramp = 100 - (ar_t / (AR_FADE_MS / (100 - AR_FADE_END)));

        ar_in = abs(get_ival(PS4_RX));
        if (abs(get_ival(PS4_RY)) > ar_in) ar_in = abs(get_ival(PS4_RY));

       if (ar_in >= AR_CUTOFF) ar_f = 0;
        else if(ar_in <= AR_SOFT) ar_f = 100;
        else ar_f = (AR_CUTOFF - ar_in) * 100 / (AR_CUTOFF - AR_SOFT);

        if(ar_f > 0) {
            ar_v = get_val(PS4_RY) + (par[P_AR_VERT] * ar_f / 100 * ar_ramp / 100);
            if(ar_v > 100) ar_v = 100;
            if(ar_v < -100) ar_v = -100;
            set_val(PS4_RY,ar_v); 
        }

    } else {
        ar_t = 0;
    }
}

function aim_assist(){
    if (get_val(PS4_L2) || get_val(PS4_R2)) {

        pat_speed++;
        if(pat_speed >= par[P_AIM_WAIT]) {
            stick_adj = (stick_adj + 2) % AIM_PAT_SIZE;
            pat_speed = 0; 
         }

        set_val(PS4_RX,get_val(PS4_RX) + ((AIM_PAT[stick_adj]     * par[P_AIM_SIZE]) / 10));
        set_val(PS4_RY, get_val(PS4_RY) + ((AIM_PAT[stick_adj + 1] * par[P_AIM_SIZE]) / 10));

		if (abs(get_ival(PS4_LX)) < 17 || abs(get_ival(PS4_LY)) <    17)
        if (par[P_AIM_LS]) {
            set_val(PS4_LX, get_val(PS4_LX) + ((AIM_PAT[stick_adj]     * 17) / 10));
            set_val(PS4_LY, get_val(PS4_LY) + ((AIM_PAT[stick_adj + 1] * 17) / 10));
        }

   } else {

        pat_speed =  0;
        stick_adj = 0;
    }
}

