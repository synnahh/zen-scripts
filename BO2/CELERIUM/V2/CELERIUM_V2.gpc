/* ==================================================================
   C E L E R I U M
   ------------------------------------------------------------------
   Black Ops II  //  Cronus Zen / GPC                     v2.0
   OFFLINE / BOT-LOBBY / CAMPAIGN / ZOMBIES BUILD
   ------------------------------------------------------------------
   MENU        : hold L2 + tap OPTIONS
   MASTER KILL : hold L2 + tap SHARE  (all mods on/off instantly)

   IN MENU:
     D-UP / D-DOWN ....... move cursor
     D-LEFT / D-RIGHT .... change value (hold to fast-scroll)
     L1 / R1 ............. previous / next page
     CROSS ............... toggle / run action
     TRIANGLE ............ reset this line to default
     CIRCLE .............. save + exit
   ------------------------------------------------------------------
   v2.0 CHANGES
     - boot animation is now a DSR-50 scanning in line by line
     - "OFFLINE" -> "ARMING" on the boot progress bar
     - OLED spacing reworked: 5 rows at 10px pitch instead of 6 at 8px,
       so nothing touches. Menu is 10 pages of 3-5 lines.
     - labels widened to 10 chars, value column moved right to 76
   ------------------------------------------------------------------
   GPC NOTES: no local variables exist - every working variable is
   declared at top level and prefixed by its owning function. Strings
   live in the data section; print() takes an address, not a literal,
   and there is no %d, so numbers go through print_num().

   SCREEN BUDGET (128 x 64, small font 7px wide / 8px tall):
     header   y 0..11
     rows     y 15, 25, 35, 45, 55   (10px pitch, 2px clear between)
     labels   x 3   (max 10 chars -> ends at 73)
     values   x 76  (max  6 chars -> ends at 118)
     scrollbr x 121..125
   ================================================================== */


/* ---------------- BUTTON LAYOUT (edit me) ---------------- */
define BTN_FIRE    = PS4_R2;
define BTN_ADS     = PS4_L2;
define BTN_MELEE   = PS4_R3;
define BTN_SPRINT  = PS4_L3;
define BTN_JUMP    = PS4_CROSS;
define BTN_CROUCH  = PS4_CIRCLE;
define BTN_RELOAD  = PS4_SQUARE;
define BTN_SWAP    = PS4_TRIANGLE;
define BTN_MENU    = PS4_OPTIONS;
define BTN_MASTER  = PS4_SHARE;

define STK_RX = PS4_RX;
define STK_RY = PS4_RY;
define STK_LX = PS4_LX;
define STK_LY = PS4_LY;

/* ---------------- MENU NAVIGATION ---------------- */
define NAV_UP    = PS4_UP;
define NAV_DOWN  = PS4_DOWN;
define NAV_LEFT  = PS4_LEFT;
define NAV_RIGHT = PS4_RIGHT;
define NAV_PGL   = PS4_L1;
define NAV_PGR   = PS4_R1;
define NAV_OK    = PS4_CROSS;
define NAV_DEF   = PS4_TRIANGLE;
define NAV_EXIT  = PS4_CIRCLE;

/* ---------------- OPTION IDs ----------------
   The ID is also the index into LBL[]. Pages take contiguous
   runs of IDs, so the order below IS the menu order. ---------- */
