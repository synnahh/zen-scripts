    wait(60);
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    set_val(BTN_ADS, 100);
    wait(ts_b);
    set_val(BTN_ADS, 100);
    wait(ts_qd);
    set_val(BTN_ADS, 100);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_ADS, 0);
    set_val(BTN_FIRE, 0);
    wait(200);
