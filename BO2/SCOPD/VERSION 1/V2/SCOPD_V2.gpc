    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 0);
    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 0);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    set_val(BTN_ADS, 100);
    wait(ts_b);
    set_val(BTN_ADS, 100);
    wait(ts_qd);
    set_val(BTN_ADS, 100);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_ADS, 0);
    set_val(BTN_FIRE, 0);
    wait(200);
}

combo TS_Barrel {
    /* shotgun barrel roll: swap out, sprint, double-tap swap, no-scope */
    set_val(BTN_SWAP, 100);
    wait(70);
    set_val(BTN_SWAP, 0);
    wait(220);
    set_val(STK_LY, -100);
    set_val(BTN_BREATH, 100);
    wait(160);
    set_val(STK_LY, -100);
    set_val(BTN_BREATH, 0);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(BTN_SWAP, 0);
    wait(60);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(BTN_SWAP, 0);
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    wait(ts_b);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_FIRE, 0);
    wait(200);
}

combo Buzz {
    set_rumble(RUMBLE_A, 60);
    wait(90);
    reset_rumble();
}

function buzz() {
    if(oval[O_RUMBLE]) combo_run(Buzz);
    return 0;
}

function stop_all() {
    combo_stop(AA_Circle);   combo_stop(AA_Pulse);   combo_stop(AA_Strafe);
    combo_stop(AimSnap);     combo_stop(QuickScope); combo_stop(AutoRescope);
    combo_stop(BoltCancel);  combo_stop(RapidFire);  combo_stop(DropShot);
    combo_stop(JumpShot);    combo_stop(AutoSprint); combo_stop(DiveAssist);
    combo_stop(YYCancel);    combo_stop(ReloadCancel);
    combo_stop(TurboMelee);
    stop_ts();
    aa_x = 0; aa_y = 0; aa_lx = 0;
    snap_x = 0; snap_y = 0;
    ar_timer = 0; br_t = 0; ads_t = 0;
    return 0;
}

function block_all() {
    set_val(PS4_LX,0);  set_val(PS4_LY,0);  set_val(PS4_RX,0);  set_val(PS4_RY,0);
    set_val(PS4_R1,0);  set_val(PS4_R2,0);  set_val(PS4_R3,0);
    set_val(PS4_L1,0);  set_val(PS4_L2,0);  set_val(PS4_L3,0);
    set_val(PS4_UP,0);  set_val(PS4_DOWN,0);
    set_val(PS4_LEFT,0);set_val(PS4_RIGHT,0);
    set_val(PS4_TRIANGLE,0); set_val(PS4_CIRCLE,0);
    set_val(PS4_CROSS,0);    set_val(PS4_SQUARE,0);
    set_val(PS4_OPTIONS,0);  set_val(PS4_SHARE,0);
    set_val(PS4_TOUCH,0);    set_val(PS4_PS,0);
    return 0;
}


/* ==================================================================
   MENU LOGIC
   ================================================================== */
function menu_logic() {
    if(event_press(NAV_PGL)) {
        m_page = m_page - 1;
        if(m_page < 0) m_page = PAGE_N - 1;
        m_item = 0;
        buzz();
    }
    if(event_press(NAV_PGR)) {
        m_page = m_page + 1;
        if(m_page >= PAGE_N) m_page = 0;
        m_item = 0;
        buzz();
    }
    if(event_press(NAV_UP)) {
        m_item = m_item - 1;
        if(m_item < 0) m_item = pg_count[m_page] - 1;
    }
    if(event_press(NAV_DOWN)) {
        m_item = m_item + 1;
        if(m_item >= pg_count[m_page]) m_item = 0;
    }

    mn_id = pg_first[m_page] + m_item;

    if(event_press(NAV_LEFT))  { adjust(mn_id, -1); rep_t = 0; }
    if(event_press(NAV_RIGHT)) { adjust(mn_id,  1); rep_t = 0; }
    if(event_press(NAV_OK))    { adjust(mn_id,  1); rep_t = 0; buzz(); }

    if(get_val(NAV_LEFT) && get_ptime(NAV_LEFT) > 380) {
        rep_t = rep_t + tick;
        if(rep_t >= 55) { rep_t = 0; adjust(mn_id, -3); }
    }
    if(get_val(NAV_RIGHT) && get_ptime(NAV_RIGHT) > 380) {
        rep_t = rep_t + tick;
        if(rep_t >= 55) { rep_t = 0; adjust(mn_id, 3); }
    }

    if(event_press(NAV_DEF)) {
        if(otyp[mn_id] != T_ACT) oval[mn_id] = odef[mn_id];
        buzz();
    }

    if(event_press(NAV_EXIT)) {
        save_all();
        menu_open = 0;
        flash(1);
        buzz();
    }
    return 0;
}

function adjust(id, dir) {
    if(otyp[id] == T_ACT) {
        do_action(id);
    } else {
        if(otyp[id] == T_ONOFF) {
            oval[id] = !oval[id];
        } else {
            aj_v = oval[id] + (dir * ostp[id]);
            if(aj_v > omax[id]) aj_v = omin[id];
            if(aj_v < omin[id]) aj_v = omax[id];
            oval[id] = aj_v;
        }
    }
    return 0;
}

function do_action(id) {
    if(id == O_APPLY) { apply_preset(); flash(2); }
    if(id == O_SAVE)  { save_all();     flash(1); }
    if(id == O_RESET) { load_defaults(); save_all(); flash(0); }
    buzz();
    return 0;
}

function flash(n) {
    notif_id = n;
    notif_t  = 900;
    return 0;
}


/* ==================================================================
   WEAPON PRESETS
   ================================================================== */
function apply_preset() {
    pp_sel = oval[O_PRESET];

    if(pp_sel == 1) {                   /* DSR-50 - slowest, hardest hitting */
        oval[O_QS_ON]=1;  oval[O_QS_DLY]=26; oval[O_BREATH]=1;
        oval[O_BOLT_ON]=1; oval[O_BOLT_DLY]=45;
        oval[O_AA_MODE]=1; oval[O_AA_POWER]=9;
        oval[O_RF_ON]=0;  oval[O_AR_ON]=0;
    }
    if(pp_sel == 2) {                   /* BALLISTA - faster bolt */
        oval[O_QS_ON]=1;  oval[O_QS_DLY]=21; oval[O_BREATH]=1;
        oval[O_BOLT_ON]=1; oval[O_BOLT_DLY]=38;
        oval[O_AA_MODE]=1; oval[O_AA_POWER]=10;
        oval[O_RF_ON]=0;  oval[O_AR_ON]=0;
    }
    if(pp_sel == 3) {                   /* SVU-AS - semi auto */
        oval[O_QS_ON]=0;  oval[O_BREATH]=2; oval[O_BOLT_ON]=0;
        oval[O_RF_ON]=1;  oval[O_RF_HOLD]=30; oval[O_RF_REST]=30;
        oval[O_AR_ON]=1;  oval[O_AR_VERT]=16;
        oval[O_AA_MODE]=1; oval[O_AA_POWER]=11;
    }
    if(pp_sel == 4) {                   /* XPR-50 - semi auto, snappier */
        oval[O_QS_ON]=0;  oval[O_BREATH]=2; oval[O_BOLT_ON]=0;
        oval[O_RF_ON]=1;  oval[O_RF_HOLD]=26; oval[O_RF_REST]=26;
        oval[O_AR_ON]=1;  oval[O_AR_VERT]=14;
        oval[O_AA_MODE]=1; oval[O_AA_POWER]=11;
    }
    if(pp_sel == 5) {                   /* QS RUSH - aggressive quickscoping */
        oval[O_QS_ON]=1;  oval[O_QS_DLY]=18; oval[O_QS_HOLD]=8;
        oval[O_RESCOPE]=1; oval[O_RESC_DLY]=28;
        oval[O_BREATH]=2; oval[O_HAIR]=1; oval[O_TRIGPT]=20;
        oval[O_JUMPS]=1;  oval[O_SNAP_ON]=1; oval[O_SCOPE_BAIT]=1;
        oval[O_AA_MODE]=4; oval[O_AA_POWER]=13;
    }
    if(pp_sel == 6) {                   /* TRICK - trickshot loadout */
        oval[O_TS_ON]=1;  oval[O_TS_SPIN]=60; oval[O_TS_DIR]=2;
        oval[O_BIND_U]=1; oval[O_BIND_D]=7;
        oval[O_BIND_L]=4; oval[O_BIND_R]=3;
        oval[O_QS_ON]=0;  oval[O_BREATH]=1;
        oval[O_AA_MODE]=1; oval[O_AA_POWER]=10;
    }
    return 0;
}


/* ==================================================================
   TABLE SETUP
   ================================================================== */
function reg(rid, rmn, rmx, rst, rty, rdv) {
    omin[rid] = rmn;  omax[rid] = rmx;  ostp[rid] = rst;
    otyp[rid] = rty;  odef[rid] = rdv;
    return 0;
}

function build_table() {
    reg(O_AA_MODE,    0,   4, 1, T_AAMODE, 1);
    reg(O_AA_POWER,   0,  40, 1, T_NUM,   10);
    reg(O_AA_SPEED,   4,  40, 1, T_NUM,   10);
    reg(O_AA_WHEN,    0,   3, 1, T_WHEN,   0);
    reg(O_AA_HIP,     0,   1, 1, T_ONOFF,  0);

    reg(O_SNAP_ON,    0,   1, 1, T_ONOFF,  1);
    reg(O_SNAP_PULL,  0,  40, 1, T_NUM,   12);
    reg(O_SNAP_DLY,   2,  30, 1, T_NUM,    6);
    reg(O_SNAP_DIR,   0,   3, 1, T_DIR4,   0);
    reg(O_SCOPE_BAIT, 0,   1, 1, T_ONOFF,  1);

    reg(O_BREATH,     0,   3, 1, T_BREATH, 1);
    reg(O_BR_DLY,     0,  50, 1, T_NUM,    8);
    reg(O_BR_HOLD,    5,  60, 1, T_NUM,   35);
    reg(O_BR_REST,    0,   1, 1, T_ONOFF,  1);

    reg(O_QS_ON,      0,   1, 1, T_ONOFF,  0);
    reg(O_QS_DLY,     5,  60, 1, T_NUM,   22);
    reg(O_QS_HOLD,    2,  20, 1, T_NUM,    8);
    reg(O_RESCOPE,    0,   1, 1, T_ONOFF,  0);
    reg(O_RESC_DLY,   5,  60, 1, T_NUM,   30);

    reg(O_BOLT_ON,    0,   1, 1, T_ONOFF,  0);
    reg(O_BOLT_DLY,   5,  80, 1, T_NUM,   42);
    reg(O_RELCAN,     0,   1, 1, T_ONOFF,  0);

    reg(O_RF_ON,      0,   1, 1, T_ONOFF,  0);
    reg(O_RF_HOLD,   10, 120, 2, T_NUM,   30);
    reg(O_RF_REST,   10, 120, 2, T_NUM,   30);
    reg(O_AR_ON,      0,   1, 1, T_ONOFF,  0);
    reg(O_AR_VERT,    0, 100, 1, T_NUM,   16);

    reg(O_DROP,       0,   3, 1, T_TRIG,   0);
    reg(O_JUMPS,      0,   3, 1, T_TRIG,   0);
    reg(O_SPRINT,     0,   1, 1, T_ONOFF,  1);
    reg(O_YYCAN,      0,   1, 1, T_ONOFF,  0);
    reg(O_DIVE,       0,   1, 1, T_ONOFF,  0);

    reg(O_HAIR,       0,   1, 1, T_ONOFF,  1);
    reg(O_TRIGPT,     5,  95, 5, T_NUM,   25);
    reg(O_MELEE,      0,   1, 1, T_ONOFF,  0);

    reg(O_TS_ON,      0,   1, 1, T_ONOFF,  0);
    reg(O_TS_MOD,     0,   3, 1, T_TSMOD,  0);
    reg(O_TS_SPIN,   20, 120, 1, T_NUM,   60);   /* x10ms -> 200..1200 */
    reg(O_TS_DIR,     0,   2, 1, T_SPIN,   2);
    reg(O_TS_SCOPE,   0,   2, 1, T_TSSCP,  0);

    reg(O_BIND_U,     0,  15, 1, T_MACRO,  0);
    reg(O_BIND_D,     0,  15, 1, T_MACRO,  0);
    reg(O_BIND_L,     0,  15, 1, T_MACRO,  0);
    reg(O_BIND_R,     0,  15, 1, T_MACRO,  0);

    reg(O_MBIND_U,    0,  15, 1, T_MACRO,  0);
    reg(O_MBIND_D,    0,  15, 1, T_MACRO,  0);
    reg(O_MBIND_L,    0,  15, 1, T_MACRO,  0);
    reg(O_MBIND_R,    0,  15, 1, T_MACRO,  0);

    reg(O_IDLE_VIEW,  0,   2, 1, T_IDLE,   0);
    reg(O_ANIM,       0,   1, 1, T_ONOFF,  1);
    reg(O_RUMBLE,     0,   1, 1, T_ONOFF,  1);

    reg(O_PRESET,     0,   6, 1, T_PRESET, 0);
    reg(O_APPLY,      0,   0, 0, T_ACT,    0);
    reg(O_SAVE,       0,   0, 0, T_ACT,    0);
    reg(O_RESET,      0,   0, 0, T_ACT,    0);
    return 0;
}

function build_pages() {
    pg_first[0]  = 0;   pg_count[0]  = 5;   /* AIM ASSIST */
    pg_first[1]  = 5;   pg_count[1]  = 5;   /* SCOPE IN   */
    pg_first[2]  = 10;  pg_count[2]  = 4;   /* BREATH     */
    pg_first[3]  = 14;  pg_count[3]  = 5;   /* QUICKSCOPE */
    pg_first[4]  = 19;  pg_count[4]  = 3;   /* BOLT WORK  */
    pg_first[5]  = 22;  pg_count[5]  = 5;   /* SEMI AUTO  */
    pg_first[6]  = 27;  pg_count[6]  = 5;   /* MOVEMENT   */
    pg_first[7]  = 32;  pg_count[7]  = 3;   /* TRIGGERS   */
    pg_first[8]  = 35;  pg_count[8]  = 5;   /* TRICKSHOT  */
    pg_first[9]  = 40;  pg_count[9]  = 4;   /* TS BINDS   */
    pg_first[10] = 44;  pg_count[10] = 4;   /* TS BINDS+  */
    pg_first[11] = 48;  pg_count[11] = 3;   /* DISPLAY    */
    pg_first[12] = 51;  pg_count[12] = 4;   /* SYSTEM     */
    return 0;
}

function load_defaults() {
    ld_i = 0;
    while(ld_i < OPT_N) {
        oval[ld_i] = odef[ld_i];
        ld_i = ld_i + 1;
    }
    return 0;
}

function clamp_all() {
    ld_i = 0;
    while(ld_i < OPT_N) {
        if(otyp[ld_i] != T_ACT) {
            if(oval[ld_i] > omax[ld_i]) oval[ld_i] = omax[ld_i];
            if(oval[ld_i] < omin[ld_i]) oval[ld_i] = omin[ld_i];
        }
        ld_i = ld_i + 1;
    }
    return 0;
}


/* ==================================================================
   PERSISTENT STORAGE - 14 slot vars, bit-packed
   ================================================================== */
function bitof(bv, bb) {
    return (bv >> bb) & 1;
}

function save_all() {
    sv_a = oval[O_AA_HIP]
         + (oval[O_SNAP_ON]    << 1)
         + (oval[O_SCOPE_BAIT] << 2)
         + (oval[O_BR_REST]    << 3)
         + (oval[O_QS_ON]      << 4)
         + (oval[O_RESCOPE]    << 5)
         + (oval[O_BOLT_ON]    << 6)
         + (oval[O_RELCAN]     << 7)
         + (oval[O_RF_ON]      << 8)
         + (oval[O_AR_ON]      << 9)
         + (oval[O_SPRINT]     << 10)
         + (oval[O_YYCAN]      << 11)
         + (oval[O_DIVE]       << 12)
         + (oval[O_HAIR]       << 13);
    set_pvar(SPVAR_1, sv_a);

    /* MELEE lives here, not in sv_a: 15 bits of bools would top out at
       32767 and get clipped by the get_pvar ceiling. */
    sv_b = oval[O_TS_ON]
         + (oval[O_ANIM]   << 1)
         + (oval[O_RUMBLE] << 2)
         + (oval[O_MELEE]  << 3);
    set_pvar(SPVAR_2, sv_b);

    set_pvar(SPVAR_3, oval[O_AA_MODE]
                    + (oval[O_AA_WHEN]  << 3)
                    + (oval[O_SNAP_DIR] << 5)
                    + (oval[O_BREATH]   << 7)
                    + (oval[O_DROP]     << 9)
                    + (oval[O_JUMPS]    << 11));

    set_pvar(SPVAR_4, oval[O_TS_MOD]
                    + (oval[O_TS_DIR]     << 2)
                    + (oval[O_TS_SCOPE]   << 4)
                    + (oval[O_IDLE_VIEW]  << 6)
                    + (oval[O_PRESET]     << 8));

    /* 8 binds x 4 bits, packed three to a pvar (12 bits, max 4095) */
    set_pvar(SPVAR_5,  oval[O_BIND_U]  + (oval[O_BIND_D]  << 4) + (oval[O_BIND_L]  << 8));
    set_pvar(SPVAR_6,  oval[O_BIND_R]  + (oval[O_MBIND_U] << 4) + (oval[O_MBIND_D] << 8));
    set_pvar(SPVAR_15, oval[O_MBIND_L] + (oval[O_MBIND_R] << 4));

    set_pvar(SPVAR_7,  oval[O_AA_POWER] + (oval[O_AA_SPEED] << 7));
    set_pvar(SPVAR_8,  oval[O_SNAP_PULL]+ (oval[O_SNAP_DLY] << 7));
    set_pvar(SPVAR_9,  oval[O_BR_DLY]   + (oval[O_BR_HOLD]  << 7));
    set_pvar(SPVAR_10, oval[O_QS_DLY]   + (oval[O_QS_HOLD]  << 7));
    set_pvar(SPVAR_11, oval[O_RESC_DLY] + (oval[O_BOLT_DLY] << 7));
    set_pvar(SPVAR_12, oval[O_RF_HOLD]  + (oval[O_RF_REST]  << 7));
    set_pvar(SPVAR_13, oval[O_AR_VERT]  + (oval[O_TRIGPT]   << 7));
    set_pvar(SPVAR_14, oval[O_TS_SPIN]  + (91 << 7));    /* 91 = magic */
    return 0;
}

function load_all() {
    lo_c = get_pvar(SPVAR_14, 0, 32000, 0);
    if((lo_c >> 7) != 91) {
        save_all();                 /* nothing valid stored - keep defaults */
    } else {
        oval[O_TS_SPIN] = lo_c & 127;

        lo_c = get_pvar(SPVAR_1, 0, 32000, 0);
        oval[O_AA_HIP]     = bitof(lo_c, 0);
        oval[O_SNAP_ON]    = bitof(lo_c, 1);
        oval[O_SCOPE_BAIT] = bitof(lo_c, 2);
        oval[O_BR_REST]    = bitof(lo_c, 3);
        oval[O_QS_ON]      = bitof(lo_c, 4);
        oval[O_RESCOPE]    = bitof(lo_c, 5);
        oval[O_BOLT_ON]    = bitof(lo_c, 6);
        oval[O_RELCAN]     = bitof(lo_c, 7);
        oval[O_RF_ON]      = bitof(lo_c, 8);
        oval[O_AR_ON]      = bitof(lo_c, 9);
        oval[O_SPRINT]     = bitof(lo_c, 10);
        oval[O_YYCAN]      = bitof(lo_c, 11);
        oval[O_DIVE]       = bitof(lo_c, 12);
        oval[O_HAIR]       = bitof(lo_c, 13);

        lo_c = get_pvar(SPVAR_2, 0, 32000, 0);
        oval[O_TS_ON]  = bitof(lo_c, 0);
        oval[O_ANIM]   = bitof(lo_c, 1);
        oval[O_RUMBLE] = bitof(lo_c, 2);
        oval[O_MELEE]  = bitof(lo_c, 3);

        lo_c = get_pvar(SPVAR_3, 0, 32000, 0);
        oval[O_AA_MODE]  =  lo_c        & 7;
        oval[O_AA_WHEN]  = (lo_c >> 3)  & 3;
        oval[O_SNAP_DIR] = (lo_c >> 5)  & 3;
        oval[O_BREATH]   = (lo_c >> 7)  & 3;
        oval[O_DROP]     = (lo_c >> 9)  & 3;
        oval[O_JUMPS]    = (lo_c >> 11) & 3;

        lo_c = get_pvar(SPVAR_4, 0, 32000, 0);
        oval[O_TS_MOD]    =  lo_c       & 3;
        oval[O_TS_DIR]    = (lo_c >> 2) & 3;
        oval[O_TS_SCOPE]  = (lo_c >> 4) & 3;
        oval[O_IDLE_VIEW] = (lo_c >> 6) & 3;
        oval[O_PRESET]    = (lo_c >> 8) & 7;

        lo_c = get_pvar(SPVAR_5, 0, 32000, 0);
        oval[O_BIND_U]  =  lo_c       & 15;
        oval[O_BIND_D]  = (lo_c >> 4) & 15;
        oval[O_BIND_L]  = (lo_c >> 8) & 15;
        lo_c = get_pvar(SPVAR_6, 0, 32000, 0);
        oval[O_BIND_R]  =  lo_c       & 15;
        oval[O_MBIND_U] = (lo_c >> 4) & 15;
        oval[O_MBIND_D] = (lo_c >> 8) & 15;
        lo_c = get_pvar(SPVAR_15, 0, 32000, 0);
        oval[O_MBIND_L] =  lo_c       & 15;
        oval[O_MBIND_R] = (lo_c >> 4) & 15;

        lo_c = get_pvar(SPVAR_7, 0, 32000, 0);
        oval[O_AA_POWER]  = lo_c & 127;  oval[O_AA_SPEED] = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_8, 0, 32000, 0);
        oval[O_SNAP_PULL] = lo_c & 127;  oval[O_SNAP_DLY] = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_9, 0, 32000, 0);
        oval[O_BR_DLY]    = lo_c & 127;  oval[O_BR_HOLD]  = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_10, 0, 32000, 0);
        oval[O_QS_DLY]    = lo_c & 127;  oval[O_QS_HOLD]  = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_11, 0, 32000, 0);
        oval[O_RESC_DLY]  = lo_c & 127;  oval[O_BOLT_DLY] = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_12, 0, 32000, 0);
        oval[O_RF_HOLD]   = lo_c & 127;  oval[O_RF_REST]  = (lo_c >> 7) & 127;
        lo_c = get_pvar(SPVAR_13, 0, 32000, 0);
        oval[O_AR_VERT]   = lo_c & 127;  oval[O_TRIGPT]   = (lo_c >> 7) & 127;

        clamp_all();
    }
    return 0;
}


/* ==================================================================
   NUMBER RENDERING
   ================================================================== */
function print_num(nx, ny, nfont, ncol, nval) {
    np_v   = nval;
    np_neg = 0;
    if(np_v < 0) { np_neg = 1; np_v = 0 - np_v; }

    np_n = 0;
    if(np_v == 0) {
        np_dig[0] = 0;
        np_n = 1;
    }
    while(np_v > 0) {
        np_dig[np_n] = np_v % 10;
        np_v = np_v / 10;
        np_n = np_n + 1;
    }

    np_i = 1;
    if(np_neg) {
        putc_oled(1, CH_MINUS);
        np_i = 2;
    }
    np_j = np_n;
    while(np_j > 0) {
        np_j = np_j - 1;
        putc_oled(np_i, CH_ZERO + np_dig[np_j]);
        np_i = np_i + 1;
    }
    puts_oled(nx, ny, nfont, np_i - 1, ncol);
    return 0;
}


/* ==================================================================
   OLED PRIMITIVES
   ================================================================== */

/* duplex sniper reticle: ring, four posts stopping short of centre */
function draw_reticle(cx, cy, rr, gp) {
    circle_oled(cx, cy, rr, 0, OLED_WHITE);
    if(rr > 4) circle_oled(cx, cy, rr - 1, 0, OLED_WHITE);
    line_oled(cx - rr, cy, cx - gp, cy, 1, OLED_WHITE);
    line_oled(cx + gp, cy, cx + rr, cy, 1, OLED_WHITE);
    line_oled(cx, cy - rr, cx, cy - gp, 1, OLED_WHITE);
    line_oled(cx, cy + gp, cx, cy + rr, 1, OLED_WHITE);
    pixel_oled(cx, cy, OLED_WHITE);
    return 0;
}

/* small standing figure */
function draw_target(gx, gy) {
    circle_oled(gx, gy, 3, 1, OLED_WHITE);
    rect_oled(gx - 3, gy + 4, 7, 9, 1, OLED_WHITE);
    line_oled(gx - 3, gy + 6, gx - 6, gy + 11, 1, OLED_WHITE);
    line_oled(gx + 3, gy + 6, gx + 6, gy + 11, 1, OLED_WHITE);
    line_oled(gx - 2, gy + 13, gx - 4, gy + 19, 1, OLED_WHITE);
    line_oled(gx + 2, gy + 13, gx + 4, gy + 19, 1, OLED_WHITE);
    return 0;
}

/* the CoD hitmarker: four diagonals with a hole in the middle */
function draw_hit(hx, hy) {
    line_oled(hx - 10, hy - 10, hx - 4, hy - 4, 1, OLED_WHITE);
    line_oled(hx + 10, hy - 10, hx + 4, hy - 4, 1, OLED_WHITE);
    line_oled(hx - 10, hy + 10, hx - 4, hy + 4, 1, OLED_WHITE);
    line_oled(hx + 10, hy + 10, hx + 4, hy + 4, 1, OLED_WHITE);
    return 0;
}


/* ==================================================================
   OLED - BOOT
     0..1400    target drifts, scope rings close, target SNAPS centre
     1400..1550 full-screen muzzle flash
     1550..2200 hitmarker over the reticle
     2200..3600 title + ARMING bar
   ================================================================== */
function draw_boot() {
    cls_oled(OLED_BLACK);

    if(boot_t < 1400) {
        bt_r = 30 - ((boot_t * 12) / 1400);        /* ring 30 -> 18   */
        bt_g = 12 - ((boot_t * 8)  / 1400);        /* post gap 12 -> 4 */
        if(boot_t < 600) {
            bt_x = 88;
        } else if(boot_t < 1000) {
            bt_x = 88 - (((boot_t - 600) * 24) / 400);   /* the snap */
        } else {
            bt_x = 64;
        }
        draw_target(bt_x, 24);
        draw_reticle(64, 34, bt_r, bt_g);

    } else if(boot_t < 1550) {
        rect_oled(0, 0, 128, 64, 1, OLED_WHITE);   /* muzzle flash */

    } else if(boot_t < 2200) {
        draw_reticle(64, 34, 18, 4);
        draw_hit(64, 34);

    } else {
        rect_oled(0, 0, 128, 14, 1, OLED_WHITE);
        print(31, 2, OLED_FONT_MEDIUM, OLED_BLACK, T_TITLE[0]);
        draw_reticle(64, 30, 10, 3);
        print(22, 44, OLED_FONT_SMALL, OLED_WHITE, T_VER[0]);
        bt_w = ((boot_t - 2200) * 124) / 1300;
        if(bt_w > 124) bt_w = 124;
        rect_oled(0, 55, 128, 8, 0, OLED_WHITE);
        rect_oled(2, 57, bt_w, 4, 1, OLED_WHITE);
    }
    return 0;
}


/* ==================================================================
   OLED - IDLE
   Two views. AUTO alternates every 4s.
     SCOPE : reticle breathing in a figure-eight. The sway collapses
             when Auto Hold Breath is on, so the display shows you
             the setting is live.
     BINDS : what each D-pad direction will fire.
   ================================================================== */
function draw_idle() {
    cls_oled(OLED_BLACK);

    rect_oled(0, 0, 128, 12, 1, OLED_WHITE);
    print(28, 2, OLED_FONT_SMALL, OLED_BLACK, T_SUB[0]);
    if(oval[O_ANIM]) {
        id_s = (anim % 26) * 6;
        rect_oled(id_s, 0, 5, 12, 1, OLED_BLACK);
    }

    if(master_off) {
        rect_oled(4, 22, 120, 20, 0, OLED_WHITE);
        print(20, 27, OLED_FONT_MEDIUM, OLED_WHITE, T_OFF[0]);
        print(10, 50, OLED_FONT_SMALL, OLED_WHITE, T_REARM[0]);
        return 0;
    }

    id_v = oval[O_IDLE_VIEW];
    if(id_v == 0) {
        id_v = 1 + ((anim / 80) % 2);       /* AUTO: swap every 4s */
    }

    if(id_v == 1) draw_view_scope();
    else draw_view_binds();
    return 0;
}

function draw_view_scope() {
    /* figure-eight sway: x on the fundamental, y at double rate */
    id_amp = 5;
    if(oval[O_BREATH] > 0) id_amp = 1;      /* breath held = steady */
    if(!oval[O_ANIM]) id_amp = 0;

    id_i  = anim % 16;
    id_sx = ((SINE[id_i] - 100) * id_amp) / 100;
    id_i  = (anim * 2) % 16;
    id_sy = ((SINE[id_i] - 100) * id_amp) / 150;

    draw_reticle(28 + id_sx, 34 + id_sy, 15, 4);
    line_oled(52, 15, 52, 49, 1, OLED_WHITE);

    print(57, 16, OLED_FONT_SMALL, OLED_WHITE, T_AA[0]);
    print(76, 16, OLED_FONT_SMALL, OLED_WHITE, V_AAMODE[oval[O_AA_MODE]]);

    print(57, 28, OLED_FONT_SMALL, OLED_WHITE, T_BR[0]);
    print(76, 28, OLED_FONT_SMALL, OLED_WHITE, V_BREATH[oval[O_BREATH]]);

    print(57, 40, OLED_FONT_SMALL, OLED_WHITE, T_QS[0]);
    if(oval[O_QS_ON]) print_num(76, 40, OLED_FONT_SMALL, OLED_WHITE, oval[O_QS_DLY] * 10);
    else print(76, 40, OLED_FONT_SMALL, OLED_WHITE, V_ONOFF[0]);

    chip_x = 1;
    if(oval[O_AA_MODE])  chip(0);
    if(oval[O_BREATH])   chip(1);
    if(oval[O_QS_ON])    chip(2);
    if(oval[O_RESCOPE])  chip(3);
    if(oval[O_BOLT_ON])  chip(4);
    if(oval[O_TS_ON])    chip(5);
    if(oval[O_RF_ON])    chip(6);
    return 0;
}

function draw_view_binds() {
    print(4, 16, OLED_FONT_SMALL, OLED_WHITE, DIRL[0]);
    print(46, 16, OLED_FONT_SMALL, OLED_WHITE, V_MACRO[oval[O_BIND_U]]);
    print(4, 27, OLED_FONT_SMALL, OLED_WHITE, DIRL[1]);
    print(46, 27, OLED_FONT_SMALL, OLED_WHITE, V_MACRO[oval[O_BIND_D]]);
    print(4, 38, OLED_FONT_SMALL, OLED_WHITE, DIRL[2]);
    print(46, 38, OLED_FONT_SMALL, OLED_WHITE, V_MACRO[oval[O_BIND_L]]);
    print(4, 49, OLED_FONT_SMALL, OLED_WHITE, DIRL[3]);
    print(46, 49, OLED_FONT_SMALL, OLED_WHITE, V_MACRO[oval[O_BIND_R]]);

    /* little D-pad glyph, arms lighting up in rotation */
    id_i = (anim / 8) % 4;
    if(!oval[O_ANIM]) id_i = 9;
    rect_oled(103, 24, 8, 8, 0, OLED_WHITE);
    rect_oled(103, 40, 8, 8, 0, OLED_WHITE);
    rect_oled(95,  32, 8, 8, 0, OLED_WHITE);
    rect_oled(111, 32, 8, 8, 0, OLED_WHITE);
    rect_oled(103, 32, 8, 8, 0, OLED_WHITE);
    if(id_i == 0) rect_oled(103, 24, 8, 8, 1, OLED_WHITE);
    if(id_i == 1) rect_oled(103, 40, 8, 8, 1, OLED_WHITE);
    if(id_i == 2) rect_oled(95,  32, 8, 8, 1, OLED_WHITE);
    if(id_i == 3) rect_oled(111, 32, 8, 8, 1, OLED_WHITE);
    return 0;
}

function chip(ci) {
    rect_oled(chip_x, 53, 16, 10, 1, OLED_WHITE);
    print(chip_x + 1, 55, OLED_FONT_SMALL, OLED_BLACK, CHIP[ci]);
    chip_x = chip_x + 18;
    return 0;
}


/* ==================================================================
   OLED - NOTIFICATIONS
   ================================================================== */
function draw_notif() {
    cls_oled(OLED_BLACK);
    rect_oled(0, 0, 128, 64, 0, OLED_WHITE);
    rect_oled(3, 3, 122, 58, 0, OLED_WHITE);
    if(notif_id == 0) print(36, 26, OLED_FONT_MEDIUM, OLED_WHITE, MSG[0]);
    if(notif_id == 1) print(36, 26, OLED_FONT_MEDIUM, OLED_WHITE, MSG[1]);
    if(notif_id == 2) print(31, 26, OLED_FONT_MEDIUM, OLED_WHITE, MSG[2]);
    if(notif_id == 3) print(31, 26, OLED_FONT_MEDIUM, OLED_WHITE, MSG[3]);
    if(notif_id == 4) print(36, 26, OLED_FONT_MEDIUM, OLED_WHITE, MSG[4]);
    return 0;
}


/* ==================================================================
   OLED - MENU
   ================================================================== */
function draw_menu() {
    cls_oled(OLED_BLACK);
    dm_base = pg_first[m_page];
    dm_n    = pg_count[m_page];

    rect_oled(0, 0, 128, 12, 1, OLED_WHITE);
    print(3, 2, OLED_FONT_SMALL, OLED_BLACK, PGN[m_page]);

    /* page counter "n/13" */
    if(m_page >= 9) {
        putc_oled(1, CH_ZERO + 1);
        putc_oled(2, CH_ZERO + ((m_page + 1) % 10));
        dm_c = 3;
    } else {
        putc_oled(1, CH_ZERO + m_page + 1);
        dm_c = 2;
    }
    putc_oled(dm_c,     CH_SLASH);
    putc_oled(dm_c + 1, CH_ZERO + 1);
    putc_oled(dm_c + 2, CH_ZERO + 3);
    puts_oled(88, 2, OLED_FONT_SMALL, dm_c + 2, OLED_BLACK);

    dm_i = 0;
    while(dm_i < dm_n) {
        dm_y  = 15 + (dm_i * 10);
        dm_id = dm_base + dm_i;
        if(dm_i == m_item) {
            rect_oled(0, dm_y - 1, 120, 10, 1, OLED_WHITE);
            print(3, dm_y, OLED_FONT_SMALL, OLED_BLACK, LBL[dm_id]);
            draw_value(dm_id, 76, dm_y, OLED_BLACK);
        } else {
            print(3, dm_y, OLED_FONT_SMALL, OLED_WHITE, LBL[dm_id]);
            draw_value(dm_id, 76, dm_y, OLED_WHITE);
        }
        dm_i = dm_i + 1;
    }

    rect_oled(121, 14, 5, 50, 0, OLED_WHITE);
    rect_oled(121, 14 + ((m_item * 46) / dm_n), 5, (46 / dm_n) + 4, 1, OLED_WHITE);
    return 0;
}

function draw_value(id, vx, vy, vc) {
    dv_t = otyp[id];
    if(dv_t == T_NUM)    print_num(vx, vy, OLED_FONT_SMALL, vc, oval[id]);
    if(dv_t == T_ONOFF)  print(vx, vy, OLED_FONT_SMALL, vc, V_ONOFF[oval[id]]);
    if(dv_t == T_AAMODE) print(vx, vy, OLED_FONT_SMALL, vc, V_AAMODE[oval[id]]);
    if(dv_t == T_WHEN)   print(vx, vy, OLED_FONT_SMALL, vc, V_WHEN[oval[id]]);
    if(dv_t == T_DIR4)   print(vx, vy, OLED_FONT_SMALL, vc, V_DIR4[oval[id]]);
    if(dv_t == T_BREATH) print(vx, vy, OLED_FONT_SMALL, vc, V_BREATH[oval[id]]);
    if(dv_t == T_TRIG)   print(vx, vy, OLED_FONT_SMALL, vc, V_TRIG[oval[id]]);
    if(dv_t == T_TSMOD)  print(vx, vy, OLED_FONT_SMALL, vc, V_TSMOD[oval[id]]);
    if(dv_t == T_SPIN)   print(vx, vy, OLED_FONT_SMALL, vc, V_SPIN[oval[id]]);
    if(dv_t == T_TSSCP)  print(vx, vy, OLED_FONT_SMALL, vc, V_TSSCP[oval[id]]);
    if(dv_t == T_IDLE)   print(vx, vy, OLED_FONT_SMALL, vc, V_IDLE[oval[id]]);
    if(dv_t == T_MACRO)  print(vx, vy, OLED_FONT_SMALL, vc, V_MACRO[oval[id]]);
    if(dv_t == T_PRESET) print(vx, vy, OLED_FONT_SMALL, vc, V_PRESET[oval[id]]);
    if(dv_t == T_ACT)    print(vx, vy, OLED_FONT_SMALL, vc, T_GO[0]);
    return 0;
}
