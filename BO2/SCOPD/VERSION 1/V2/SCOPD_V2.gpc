/* ---------------- TRICKSHOT MACROS ----------------
   Every one spins blind for ts_a, then keeps spinning while the
   scope comes up for ts_b, then fires. ---------------- */
combo TS_Scope {
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    set_val(BTN_ADS, 100);
    wait(ts_b);
    set_val(BTN_ADS, 100);
    wait(ts_qd);
    set_val(BTN_ADS, 100);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_ADS, 0);
    set_val(BTN_FIRE, 0);
    wait(200);
}

combo TS_NoScope {
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    wait(ts_b);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_FIRE, 0);
    wait(200);
}

combo TS_Jump {
    set_val(BTN_JUMP, 100);
    wait(70);
    set_val(BTN_JUMP, 0);
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    set_val(BTN_ADS, 100);
    wait(ts_b);
    set_val(BTN_ADS, 100);
    wait(ts_qd);
    set_val(BTN_ADS, 100);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_ADS, 0);
    set_val(BTN_FIRE, 0);
