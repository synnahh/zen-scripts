}

combo TS_Temper {
    /* Temperr shot: jump, fake the zoom, YY through the spin, no-scope,
       then swap to secondary on the way out. */
    set_val(BTN_JUMP, 100);
    wait(70);
    set_val(BTN_JUMP, 0);
    set_val(BTN_ADS, 100);
    wait(130);                          /* fake zoom */
    set_val(BTN_ADS, 0);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 0);
    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(STK_RX, ts_pow);
    set_val(BTN_SWAP, 0);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    wait(ts_b);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_FIRE, 0);
    wait(90);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(BTN_SWAP, 0);
    wait(150);
}

combo TS_Swap {
    /* insta swap: land the quickscope, then pull the secondary
       before the shot even registers on screen */
    set_val(STK_RX, ts_pow);
    wait(ts_a);
    set_val(STK_RX, ts_pow);
    set_val(BTN_ADS, 100);
    wait(ts_b);
    set_val(BTN_ADS, 100);
    wait(ts_qd);
    set_val(BTN_ADS, 100);
    set_val(BTN_FIRE, 100);
    wait(90);
    set_val(BTN_ADS, 0);
    set_val(BTN_FIRE, 0);
    wait(40);
    set_val(BTN_SWAP, 100);
    wait(60);
    set_val(BTN_SWAP, 0);
    wait(150);
}

