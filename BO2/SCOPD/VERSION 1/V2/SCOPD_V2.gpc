/* ==================================================================
   INIT
   ================================================================== */
init {
    vm_tctrl(-8);
    build_table();
    build_pages();
    load_defaults();
    load_all();
    boot_t = 0;
    anim   = 0;
}


/* ==================================================================
   MAIN
   ================================================================== */
main {
    tick = get_rtime();

    aa_pw  = oval[O_AA_POWER];
    aa_d   = (aa_pw * 7) / 10;
    aa_sp  = oval[O_AA_SPEED];
    aa_sp2 = aa_sp / 2;
    if(aa_sp2 < 2) aa_sp2 = 2;
    aa_spl  = aa_sp * 2;
    rf_h    = oval[O_RF_HOLD];
    rf_r    = oval[O_RF_REST];
    qs_d    = oval[O_QS_DLY]   * 10;
    qs_h    = oval[O_QS_HOLD]  * 10;
    resc_d  = oval[O_RESC_DLY] * 10;
    bolt_d  = oval[O_BOLT_DLY] * 10;
    snap_dl = oval[O_SNAP_DLY] * 10;

    if(get_val(BTN_ADS) > 40) {
        set_val(BTN_MENU, 0);
        set_val(BTN_MASTER, 0);
        if(event_press(BTN_MENU)) {
            if(menu_open) {
                save_all();
                menu_open = 0;
                flash(1);
            } else {
                menu_open = 1;
                m_item = 0;
                stop_all();
            }
            buzz();
        }
        if(event_press(BTN_MASTER)) {
            master_off = !master_off;
            stop_all();
            if(master_off) flash(3);
            else flash(4);
            buzz();
        }
    }

    if(menu_open) {
        menu_logic();
        block_all();
    } else {
        if(!master_off) run_mods();
    }

    oled_t = oled_t + tick;
    if(oled_t >= 50) {
        oled_t = 0;
        anim = anim + 1;
        if(anim > 2000) anim = 0;
        if(boot_t < 3600) {
            boot_t = boot_t + 50;
            draw_boot();
        } else if(menu_open) {
            draw_menu();
        } else if(notif_t > 0) {
            draw_notif();
        } else {
            draw_idle();
        }
    }
    if(notif_t > 0) notif_t = notif_t - tick;
}


/* ==================================================================
   MOD ENGINE
   ================================================================== */
function run_mods() {

    /* ---------- trigger conditioning ---------- */
    if(oval[O_HAIR]) {
        if(get_val(BTN_FIRE) >= oval[O_TRIGPT]) set_val(BTN_FIRE, 100);
        else set_val(BTN_FIRE, 0);
        if(get_val(BTN_ADS) >= oval[O_TRIGPT]) set_val(BTN_ADS, 100);
    }

    ads_now  = 0;
    fire_now = 0;
    if(get_val(BTN_ADS)  > 40) ads_now  = 1;
    if(get_val(BTN_FIRE) > 40) fire_now = 1;

    if(ads_now) ads_t = ads_t + tick;
    else ads_t = 0;

    /* ---------- TRICKSHOT BINDS ---------- */
    trickshot();

    /* ---------- AUTO HOLD BREATH ----------
       ALWAYS holds the moment you scope. SMART only holds once your
       finger is on the trigger, which stops the meter draining while
       you are just panning. DELAY waits out the scope-in first.      */
    br_want = 0;
    if(oval[O_BREATH] > 0 && ads_now) {
        if(oval[O_BREATH] == 1) br_want = 1;
        if(oval[O_BREATH] == 2 && get_val(BTN_FIRE) > 5) br_want = 1;
        if(oval[O_BREATH] == 3 && ads_t >= (oval[O_BR_DLY] * 10)) br_want = 1;
    }
    if(br_want) {
        if(oval[O_BR_REST]) {
            /* cycle: hold for MAX HOLD, then let go 600ms to recover */
            br_t = br_t + tick;
            if(br_t <= (oval[O_BR_HOLD] * 100)) set_val(BTN_BREATH, 100);
            else if(br_t > ((oval[O_BR_HOLD] * 100) + 600)) br_t = 0;
        } else {
            set_val(BTN_BREATH, 100);
        }
    } else {
        br_t = 0;
    }

    /* ---------- ANTI-RECOIL (semi-auto snipers) ---------- */
    if(oval[O_AR_ON] && fire_now) {
        ar_ry = get_val(STK_RY);
        if(oval[O_AR_VERT] != 0) {
            if(ar_ry <  oval[O_AR_VERT] && ar_ry > (0 - oval[O_AR_VERT]))
                ar_ry = oval[O_AR_VERT];
        }
        set_val(STK_RY, clampv(ar_ry));
    }

    /* ---------- AIM ASSIST ENHANCER ---------- */
    aa_on = 0;
    if(oval[O_AA_MODE] > 0) {
        if(oval[O_AA_WHEN] == 0 && ads_now) aa_on = 1;
        if(oval[O_AA_WHEN] == 1 && fire_now) aa_on = 1;
        if(oval[O_AA_WHEN] == 2 && ads_now && fire_now) aa_on = 1;
        if(oval[O_AA_WHEN] == 3) aa_on = 1;
        if(oval[O_AA_HIP] && fire_now && !ads_now) aa_on = 1;
    }
    /* scope bait: force the sway on during the scope-in window, which
       is when BO2's aim assist is at its stickiest */
    if(oval[O_SCOPE_BAIT] && ads_now && ads_t < 400) aa_on = 1;

    if(aa_on) {
        if(oval[O_AA_MODE] == 1) combo_run(AA_Circle);
        if(oval[O_AA_MODE] == 2) combo_run(AA_Pulse);
        if(oval[O_AA_MODE] == 3) combo_run(AA_Strafe);
        if(oval[O_AA_MODE] == 4) {
            combo_run(AA_Circle);
            combo_run(AA_Strafe);
        }
        if(oval[O_AA_MODE] == 0 && oval[O_SCOPE_BAIT]) combo_run(AA_Strafe);
    } else {
        combo_stop(AA_Circle);
        combo_stop(AA_Pulse);
        combo_stop(AA_Strafe);
        aa_x = 0; aa_y = 0; aa_lx = 0;
    }

    if(aa_x != 0 || aa_y != 0 || snap_x != 0 || snap_y != 0) {
        set_val(STK_RX, clampv(get_val(STK_RX) + aa_x + snap_x));
        set_val(STK_RY, clampv(get_val(STK_RY) + aa_y + snap_y));
    }
    if(aa_lx != 0) set_val(STK_LX, clampv(get_val(STK_LX) + aa_lx));

    /* ---------- SNAP AIM (double zoom) ----------
       The nudge vector is resolved here, not inside the combo - GPC
       combos take set_val and wait, not branching. */
    snap_vx = 0;
    snap_vy = 0;
    if(oval[O_SNAP_DIR] == 0) snap_vy =     oval[O_SNAP_PULL];
    if(oval[O_SNAP_DIR] == 1) snap_vy = 0 - oval[O_SNAP_PULL];
    if(oval[O_SNAP_DIR] == 2) snap_vx = 0 - oval[O_SNAP_PULL];
    if(oval[O_SNAP_DIR] == 3) snap_vx =     oval[O_SNAP_PULL];
    if(oval[O_SNAP_ON] && event_press(BTN_ADS)) combo_run(AimSnap);
    if(combo_running(AimSnap)) set_val(BTN_ADS, 100);

    /* ---------- QUICKSCOPE ---------- */
    if(oval[O_QS_ON] && event_press(BTN_ADS)) combo_run(QuickScope);

    /* ---------- POST-SHOT WORK ---------- */
    if(ads_now && event_press(BTN_FIRE)) {
        if(oval[O_RESCOPE]) combo_run(AutoRescope);
        if(oval[O_BOLT_ON]) combo_run(BoltCancel);
    }

    /* ---------- SEMI AUTO RAPID FIRE ---------- */
    if(oval[O_RF_ON] && fire_now) combo_run(RapidFire);
    else combo_stop(RapidFire);

    /* ---------- MOVEMENT ---------- */
    if(shot_trig(oval[O_DROP]))  combo_run(DropShot);
    if(shot_hold(oval[O_JUMPS])) combo_run(JumpShot);
    if(oval[O_SPRINT] && !ads_now && get_val(STK_LY) < -70) combo_run(AutoSprint);
    if(oval[O_YYCAN] && get_val(BTN_SWAP)) combo_run(YYCancel);
    if(oval[O_DIVE] && !ads_now && get_val(BTN_CROUCH) && get_val(STK_LY) < -70)
        combo_run(DiveAssist);

    /* ---------- EXTRAS ---------- */
    if(oval[O_RELCAN] && event_press(BTN_RELOAD)) combo_run(ReloadCancel);
    if(oval[O_MELEE] && get_val(BTN_MELEE)) combo_run(TurboMelee);
}


/* ==================================================================
   TRICKSHOT BINDING
   A direction with a macro bound to it is consumed by the script.
   A direction left on OFF passes through to the game untouched, so
   you keep your scorestreaks on the directions you don't use.
   ================================================================== */
function trickshot() {
    if(!oval[O_TS_ON]) return 0;

    /* Is the modifier held? If so we read the SECOND bind set and
       swallow the modifier button so it doesn't reach the game.
       L3 is the safe default - holding it only sprints, and you are
       standing still anyway. Never use a grenade button here: BO2
       cooks lethals on hold. */
    ts_mod = 0;
    if(oval[O_TS_MOD] == 1 && get_val(BTN_BREATH)) ts_mod = 1;
    if(oval[O_TS_MOD] == 2 && get_val(BTN_MASTER)) ts_mod = 1;
    if(oval[O_TS_MOD] == 3 && get_val(BTN_TAC))    ts_mod = 1;
    if(ts_mod) {
        if(oval[O_TS_MOD] == 1) set_val(BTN_BREATH, 0);
        if(oval[O_TS_MOD] == 2) set_val(BTN_MASTER, 0);
        if(oval[O_TS_MOD] == 3) set_val(BTN_TAC, 0);
    }

    if(ts_mod) {
        if(oval[O_MBIND_U] > 0) {
            set_val(NAV_UP, 0);
            if(event_press(NAV_UP))    fire_macro(oval[O_MBIND_U], 0);
        }
        if(oval[O_MBIND_D] > 0) {
            set_val(NAV_DOWN, 0);
            if(event_press(NAV_DOWN))  fire_macro(oval[O_MBIND_D], 0);
        }
        if(oval[O_MBIND_L] > 0) {
            set_val(NAV_LEFT, 0);
            if(event_press(NAV_LEFT))  fire_macro(oval[O_MBIND_L], 1);
        }
        if(oval[O_MBIND_R] > 0) {
            set_val(NAV_RIGHT, 0);
            if(event_press(NAV_RIGHT)) fire_macro(oval[O_MBIND_R], 2);
        }
    } else {
        if(oval[O_BIND_U] > 0) {
            set_val(NAV_UP, 0);
            if(event_press(NAV_UP))    fire_macro(oval[O_BIND_U], 0);
        }
        if(oval[O_BIND_D] > 0) {
            set_val(NAV_DOWN, 0);
            if(event_press(NAV_DOWN))  fire_macro(oval[O_BIND_D], 0);
        }
        if(oval[O_BIND_L] > 0) {
            set_val(NAV_LEFT, 0);
            if(event_press(NAV_LEFT))  fire_macro(oval[O_BIND_L], 1);
        }
        if(oval[O_BIND_R] > 0) {
            set_val(NAV_RIGHT, 0);
            if(event_press(NAV_RIGHT)) fire_macro(oval[O_BIND_R], 2);
        }
    }
    return 0;
}

/* dhint: 0 = neutral, 1 = pressed LEFT, 2 = pressed RIGHT.
   Used only when SPIN DIR is AUTO. */
function fire_macro(mac, dhint) {
    /* --- spin direction --- */
    ts_pow = 100;
    if(oval[O_TS_DIR] == 1) ts_pow = -100;
    if(oval[O_TS_DIR] == 2) {
        if(dhint == 1) ts_pow = -100;
        else ts_pow = 100;
    }

    /* --- scope timing --- */
    ts_qd = qs_d;
    if(oval[O_TS_SCOPE] == 1) ts_qd = qs_d + 250;      /* hardscope */

    /* --- how far to rotate. SPIN 360ms is one rotation; the rest
           are multiples of it, so calibrating 360 calibrates all. --- */
    ts_tot = oval[O_TS_SPIN] * 10;
    if(mac == 1) ts_tot = ts_tot / 2;                  /* 180  */
    if(mac == 3) ts_tot = (ts_tot * 3) / 2;            /* 540  */
    if(mac == 4) ts_tot = ts_tot * 2;                  /* 720  */
    if(mac == 5) ts_tot = ts_tot * 3;                  /* 1080 */
    if(ts_tot > 3600) ts_tot = 3600;                   /* wait() ceiling */

    /* split: spin blind, then keep spinning while the scope comes up */
    ts_b = (ts_tot * 4) / 10;
    ts_a = ts_tot - ts_b;
    if(ts_a < 20) ts_a = 20;
    if(ts_b < 20) ts_b = 20;

    ts_sel = mac;
    stop_ts();

    if(mac >= 1 && mac <= 5) combo_run(TS_Scope);      /* 180/360/540/720/1080 */
    if(mac == 6)  combo_run(TS_NoScope);
    if(mac == 7)  combo_run(TS_Jump);
    if(mac == 8)  combo_run(TS_Drop);
    if(mac == 9)  combo_run(TS_Dive);
    if(mac == 10) combo_run(TS_Temper);
    if(mac == 11) combo_run(TS_Swap);
    if(mac == 12) combo_run(TS_Axe);
    if(mac == 13) combo_run(TS_Knife);
    if(mac == 14) combo_run(TS_Reload);
    if(mac == 15) combo_run(TS_Barrel);
    buzz();
    return 0;
}

function stop_ts() {
    combo_stop(TS_Scope);  combo_stop(TS_NoScope); combo_stop(TS_Jump);
    combo_stop(TS_Drop);   combo_stop(TS_Dive);    combo_stop(TS_Temper);
    combo_stop(TS_Swap);   combo_stop(TS_Axe);     combo_stop(TS_Knife);
    combo_stop(TS_Reload); combo_stop(TS_Barrel);
    return 0;
}

function shot_trig(m) {
    if(m == 1 && event_press(BTN_FIRE)) return 1;
    if(m == 2 && event_press(BTN_ADS))  return 1;
    if(m == 3) {
        if(event_press(BTN_FIRE)) return 1;
        if(event_press(BTN_ADS))  return 1;
    }
    return 0;
}

function shot_hold(m) {
    if(m == 1 && get_val(BTN_FIRE) > 40) return 1;
    if(m == 2 && get_val(BTN_ADS)  > 40) return 1;
    if(m == 3) {
        if(get_val(BTN_FIRE) > 40) return 1;
        if(get_val(BTN_ADS)  > 40) return 1;
    }
    return 0;
}

function clampv(v) {
    if(v >  100) return  100;
    if(v < -100) return -100;
    return v;
}


/* ==================================================================
   COMBOS
   ================================================================== */
combo AA_Circle {
    aa_x = aa_pw;    aa_y = 0;        wait(aa_sp);
    aa_x = aa_d;     aa_y = aa_d;     wait(aa_sp);
    aa_x = 0;        aa_y = aa_pw;    wait(aa_sp);
    aa_x = 0-aa_d;   aa_y = aa_d;     wait(aa_sp);
    aa_x = 0-aa_pw;  aa_y = 0;        wait(aa_sp);
    aa_x = 0-aa_d;   aa_y = 0-aa_d;   wait(aa_sp);
    aa_x = 0;        aa_y = 0-aa_pw;  wait(aa_sp);
    aa_x = aa_d;     aa_y = 0-aa_d;   wait(aa_sp);
}

combo AA_Pulse {
    aa_x = aa_pw;    aa_y = 0;  wait(aa_sp);
    aa_x = 0;        aa_y = 0;  wait(aa_sp2);
    aa_x = 0-aa_pw;  aa_y = 0;  wait(aa_sp);
    aa_x = 0;        aa_y = 0;  wait(aa_sp2);
}

combo AA_Strafe {
    aa_lx = aa_pw;    wait(aa_spl);
    aa_lx = 0-aa_pw;  wait(aa_spl);
}

combo AimSnap {
    set_val(BTN_ADS, 100);
    wait(snap_dl);
    set_val(BTN_ADS, 0);
    wait(40);
    set_val(BTN_ADS, 100);
    snap_x = snap_vx;
    snap_y = snap_vy;
    wait(70);
    snap_x = 0;
    snap_y = 0;
    set_val(BTN_ADS, 100);
    wait(30);
}

combo QuickScope {
    set_val(BTN_ADS, 100);
