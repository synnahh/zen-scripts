/* THE LIBRARY. Eight bytes per macro:
       PRE1  PRE2  CAN1  CAN2  CAN3  SPIN  FIN1  FIN2
   Index = the V_MACRO[] index, so a name and its behaviour can never
   drift apart. Slots (37..40) read the same eight fields out of
   ts_slot[] instead.

   PRE  0 none 1 jump 2 dive 3 swap 4 prone 5 crouch 6 sprint
   CAN  0 none 1 YY 2 YYY 3 YYYY 4 reload 5 axe 6 melee 7 tac
   SPIN 0 none 1 180 2 360 3 540 4 720 5 900 6 1080
   FIN  0 none 1 prone 2 melee 3 swap 4 crouch 5 jump 6 reload   */
const uint8 MACDEF[] = {
    0,0, 0,0,0, 0, 0,0,   /*  0 OFF                                    */
    0,0, 0,0,0, 1, 0,0,   /*  1 180                                    */
    0,0, 0,0,0, 2, 0,0,   /*  2 360                                    */
    0,0, 0,0,0, 3, 0,0,   /*  3 540                                    */
    0,0, 0,0,0, 4, 0,0,   /*  4 720                                    */
    0,0, 0,0,0, 5, 0,0,   /*  5 900                                    */
    0,0, 0,0,0, 6, 0,0,   /*  6 1080                                   */
    0,0, 1,0,0, 1, 0,0,   /*  7 YY180                                  */
    0,0, 1,0,0, 2, 0,0,   /*  8 YY360   the bread and butter           */
    0,0, 1,0,0, 3, 0,0,   /*  9 YY540                                  */
    0,0, 1,0,0, 4, 0,0,   /* 10 YY720                                  */
    0,0, 1,0,0, 6, 0,0,   /* 11 YY1080                                 */
    0,0, 2,0,0, 2, 0,0,   /* 12 YYY360                                 */
    0,0, 2,0,0, 4, 0,0,   /* 13 YYY720                                 */
    0,0, 1,1,0, 2, 0,0,   /* 14 YY2360  two cancels, STAGE apart       */
    0,0, 1,1,0, 4, 0,0,   /* 15 YY2720                                 */
    1,0, 0,0,0, 2, 0,0,   /* 16 JMP360                                 */
    1,0, 0,0,0, 4, 0,0,   /* 17 JMP720                                 */
    1,0, 1,0,0, 2, 0,0,   /* 18 JMPYY                                  */
    1,0, 1,1,0, 2, 0,0,   /* 19 JMPYY2  both cancels inside the arc    */
    6,1, 1,0,0, 2, 0,0,   /* 20 RUNJMP  sprint into the jump           */
    6,1, 1,1,0, 4, 0,0,   /* 21 RUN720  running jump, two cancels      */
    0,0, 0,0,0, 2, 1,0,   /* 22 DRP360  spin into prone                */
    0,0, 1,0,0, 2, 1,0,   /* 23 DRPYY                                  */
    0,0, 1,0,0, 2, 1,2,   /* 24 DRPMEL  drop, then melee off the deck  */
    2,0, 0,0,0, 2, 0,0,   /* 25 DIV360  dolphin dive                   */
    2,0, 0,0,0, 4, 0,0,   /* 26 DIV720                                 */
    2,0, 1,0,0, 2, 0,0,   /* 27 DIVYY                                  */
    1,0, 1,0,0, 2, 3,0,   /* 28 TEMPER  jump, YY, 360, swap out        */
    1,0, 1,1,0, 2, 3,0,   /* 29 TEMPR2  TEMPER with the second cancel  */
    0,0, 5,0,0, 2, 0,0,   /* 30 AXE360  axe throw, YY-cancelled        */
    0,0, 5,1,0, 3, 0,0,   /* 31 AXEYY2  axe cancel, then a clean YY    */
    0,0, 4,0,0, 2, 0,0,   /* 32 RLD360  reload, YY-cancelled           */
    0,0, 4,5,0, 2, 0,0,   /* 33 RLDAXE  reload cancel into axe cancel  */
    0,0, 6,0,0, 2, 0,0,   /* 34 MEL360  melee, YY-cancelled            */
    3,0, 1,0,0, 2, 0,0,   /* 35 BARREL  swap out first, then YY        */
    6,1, 4,1,1, 6, 1,2    /* 36 MONSTR  the whole vocabulary at once   */
};

