define BTN_CROUCH  = PS4_CIRCLE; /* tap = crouch, hold = prone */
define BTN_RELOAD  = PS4_SQUARE;
define BTN_SWAP    = PS4_TRIANGLE;
define BTN_MENU    = PS4_OPTIONS;
define BTN_MASTER  = PS4_SHARE;
define BTN_TAC     = PS4_L1;
define BTN_LETHAL  = PS4_R1;     /* combat axe for the AXE cancel */

