    "D-PAD RGHT", "M+ UP", "M+ DOWN", "M+ LEFT", "M+ RIGHT", "MODE",
    "DELAY x10", "MAX HOLD", "AUTO REST", "ENABLE", "QS DELAY", "FIRE HOLD",
    "AUTO RESCP", "RESCP DLY", "BOLT CANCL", "BOLT DELAY", "RELOAD CAN", "DROP SHOT",
    "JUMP SHOT", "AUTOSPRINT", "YY CANCEL", "DIVE HELP", "TURBO MELE", "EYE BLINK",
    "EYE LOOK", "TEAR", "TIMELINE", "RUMBLE", "PRESET", "APPLY",
    "SAVE ALL", "RESET ALL", "TS AUTO", "ENABLE", "TRIGGER", "TAP ms",
    "GAP ms", "XTRA DOWN", "FIRE TEST"
};


/* THE LIBRARY. Eight bytes per macro:
       PRE1  PRE2  CAN1  CAN2  CAN3  CAN4  SPIN  FIN
   Index = the V_MACRO[] index, so a name and its behaviour can never
   drift apart. Slots (41..44) read the same eight fields out of
   ts_slot[] instead.

   PRE  0 none 1 jump 2 dive 3 swap 4 prone 5 crouch 6 sprint
   CAN  0 none 1 YY 2 YYY 3 YYYY 4 reload 5 axe 6 melee 7 tac
   SPIN 0 none 1 180 2 360 3 540 4 720 5 900 6 1080
   FIN  0 none 1 prone 2 melee 3 swap 4 crouch 5 jump 6 reload 7 prone+melee */

const uint8 MACDEF[] = {
    0, 0, 0, 0, 0, 0, 0, 0,   /*  0 OFF */
    0, 0, 0, 0, 0, 0, 1, 0,   /*  1 180 */
    0, 0, 0, 0, 0, 0, 2, 0,   /*  2 360 */
    0, 0, 0, 0, 0, 0, 3, 0,   /*  3 540 */
    0, 0, 0, 0, 0, 0, 4, 0,   /*  4 720 */
    0, 0, 0, 0, 0, 0, 5, 0,   /*  5 900 */
    0, 0, 0, 0, 0, 0, 6, 0,   /*  6 1080 */
    0, 0, 5, 0, 0, 0, 3, 0,   /*  7 AXE540 */
    0, 0, 1, 0, 0, 0, 2, 0,   /*  8 YY360 */
    0, 0, 1, 0, 0, 0, 3, 0,   /*  9 YY540 */
    0, 0, 1, 0, 0, 0, 4, 0,   /* 10 YY720 */
    0, 0, 5, 0, 0, 0, 4, 0,   /* 11 AXE720 */
    0, 0, 2, 0, 0, 0, 2, 0,   /* 12 YYY360 */
