define OPT_N    = 75;
define PAGE_N   = 14;
define PG_SLOT  = 3;          /* the slot-editing page - PGN[3] = "SLOT EDIT".
                                  Was 4 (= "CALIBRATE") in v10: slot_sync()
                                  gates on m_page == PG_SLOT, so with the
                                  wrong page id it NEVER ran while you were
                                  actually on SLOT EDIT. That's why editing
                                  PRE/CANCEL/SPIN/FINISH on a custom slot
                                  never wrote back to ts_slot[] - the fields
                                  on screen were live, but nothing behind
                                  them ever changed, so SAVE ALL / CIRCLE
                                  always wrote back the untouched original
                                  slot data. */
/* A trickshot is EIGHT fields. Order is fixed and shared by MACDEF[],
   SLOTDEF[], ts_slot[], st[] and the SLOT EDIT lines:
     0 PRE 1   1 PRE 2   2 CANCEL 1   3 CANCEL 2
     4 CANCEL 3   5 CANCEL 4   6 SPIN   7 FINISH
   FINISH can be a composite value (PR+MEL) - see V_FIN[] - so a
   two-action ending still fits the one field. */
define SL_STRIDE = 8;
define N_MACRO  = 45;         /* 41 library + 4 slots */
define MAGIC    = 94;         /* save format tag - bump when a layout changes */

/* ---------------- VALUE TYPES ---------------- */
