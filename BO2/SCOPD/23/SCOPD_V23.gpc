/* THE LIBRARY. Seven bytes per move, spin dropped from the table
   entirely - it's picked when you bind the move, not baked into it,
   so one "AXE" entry now covers every spin amount instead of AXE360/
   540/720/1080 each needing their own slot. Index = MOVE_NAME[]
   index, grouped by family via FAM_FIRST[]/FAM_COUNT[] (mac = index
   + 1 in bind storage, since mac 0 is reserved for OFF). Slots
   (mac 30..33) read their own fields out of ts_slot[] instead, and
   keep their own SPIN field since they're hand-built per slot rather
   than picked from this library.

   PRE  0 none 1 jump 2 dive 3 swap 4 prone 5 crouch 6 sprint
   CAN  0 none 1 YY 2 YYY 3 YYYY 4 reload 5 axe 6 melee 7 tac
   FIN  0 none 1 prone 2 melee 3 swap 4 crouch 5 jump 6 reload 7 prone+melee */

const uint8 MOVEDEF[] = {
     0,  0,  0,  0,  0,  0,  0,  0,   /*  0 SPIN */
     0,  0,  1,  0,  0,  0,  0,  0,   /*  1 YY */
     0,  0,  2,  0,  0,  0,  0,  0,   /*  2 YYY */
     1,  0,  0,  0,  0,  0,  0,  0,   /*  3 JUMP */
     0,  0,  5,  0,  0,  0,  0,  0,   /*  4 AXE */
     0,  0,  4,  0,  0,  0,  0,  0,   /*  5 RELOAD */
     0,  0,  6,  0,  0,  0,  0,  0,   /*  6 MELEE */
     1,  0,  1,  1,  0,  0,  0,  0,   /*  7 JMPYY2 */
     0,  0,  5,  1,  0,  0,  0,  0,   /*  8 AXEYY */
     0,  0,  4,  5,  0,  0,  0,  0,   /*  9 RLDAXE */
     0,  0,  1,  1,  1,  1,  0,  0,   /* 10 QUADCAN */
     1,  0,  1,  0,  0,  0,  3,  0,   /* 11 TEMPER */
     1,  0,  1,  1,  0,  0,  3,  0,   /* 12 TEMPR2 */
     6,  1,  4,  1,  1,  0,  7,  0,   /* 13 MONSTR */
     0,  0,  4,  0,  0,  0,  0,  0,   /* 14 MONEYNAC */
     0,  0,  1,  0,  0,  0,  0,  0,   /* 15 TITTYNAC */
     0,  0,  4,  0,  0,  0,  0,  0,   /* 16 RLDNAC */
     0,  0,  1,  0,  0,  0,  0,  0,   /* 17 HYBRDNAC */
     0,  0,  1,  0,  0,  0,  0,  0,   /* 18 SELFIRE */
     3,  0,  1,  0,  0,  0,  0,  0,   /* 19 BARREL */
     0,  0,  1,  7,  0,  0,  0,  0,   /* 20 INSTASW */
     0,  0,  6,  0,  0,  0,  0,  0,   /* 21 KNIFEFL */
     0,  0,  0,  0,  0,  0,  1,  0,   /* 22 DROP */
     0,  0,  1,  0,  0,  0,  1,  0,   /* 23 DROPYY */
