     1,  0,  0,  0,  0,  0,  0,  0,   /* 25 LADSTALL */
     0,  0,  0,  0,  0,  0,  0,  0,   /* 26 TOPSPIN */
     1,  0,  0,  0,  0,  0,  0,  0,   /* 27 RUNMAN */
     6,  0,  0,  0,  0,  0,  0,  0,   /* 28 MOONWLK */
     0,  0,  0,  0,  0,  0,  0,  4,   /* 29 INFADE */
