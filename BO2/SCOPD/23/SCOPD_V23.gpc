/* Hidden companions to the 8 bind slots above (BIND_U..R, MBIND_U..R
   are ids 33..40, consecutive) - not on any page, only ever set by
   the family browser, never navigated to directly. bind_index =
   mac_id - O_BIND_U works uniformly for both BIND and MBIND since
   they're one consecutive run of 8 ids. */
define O_BIND_SPIN0 = 77;     /* +8 spin companions, 76..83  */
define O_BIND_SW0   = 85;     /* +8 switch companions, 84..91 */
define PG_SLOT  = 5;          /* the slot-editing page - PGN[5] = "SLOT EDIT"
                                  after the v4.7 reorder (was 3). slot_sync()
                                  gates on m_page == PG_SLOT - this MUST move
                                  in lockstep with SLOT EDIT's position in
                                  PGN[]/PGFIRST[]/PGCOUNT[] or the v10 bug
                                  (edits silently not saving) comes back. */
/* Custom slots (SLOT EDIT, ts_slot[]) are still EIGHT fields, SPIN
   baked in same as always:
     0 PRE 1   1 PRE 2   2 CANCEL 1   3 CANCEL 2
     4 CANCEL 3   5 CANCEL 4   6 SPIN   7 FINISH
   Library moves (MOVEDEF[]) dropped SPIN - it's chosen at bind time
   instead - so they're the same layout minus field 6: PRE1 PRE2 CAN1
   CAN2 CAN3 CAN4 FIN. ts_load() re-assembles both into the same
   9-field st[] (the 8 above plus SWITCH) so ts_build() never needs
   to know which source it came from. FINISH can be a composite value
   (PR+MEL) - see V_FIN[] - so a two-action ending still fits one
   field. */
define SL_STRIDE = 9;
define N_MACRO  = 45;         /* 41 library + 4 slots */
define MAGIC    = 95;         /* save format tag - bump when a layout changes.
                                  v5.4: slots grew a 9th field (INFADE) and
                                  their pvar packing moved (SPVAR_20-27 ->
                                  39-47) to fit it - old packed data doesn't
                                  translate, so this is a clean reset rather
                                  than a guessed migration, same call as the
                                  v4.0 layout change. */

