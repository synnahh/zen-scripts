combo JUGGLING_RAINBOW_cmb {
  LS_BlockOutput = TRUE;
  call(STOP_PLAYER_cmb);
  wait(60);
  call(JUGGLING_cmb);
  call(JUGGLING_cmb);
  call(JUGGLING_cmb);
  call(JUGGLING_cmb);
  call(JUGGLING_cmb);
  set_val(PaceCtrol,100);
  RA_DOWN ();    // down 
  wait(70);      
  set_val(PaceCtrol,100);
  RA_ZERO();     // Zero 
  wait(40);
  set_val(PaceCtrol,100);
  RA_UP();        // up   
  wait(70);
  set_val(PaceCtrol,100);
  wait(800);
  LS_BlockOutput = FALSE;
    Get_LS_Output = TRUE;
}
