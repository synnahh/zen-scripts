//////////////////////////////////////////////////////////////
combo STEP_OVER_FEINT {      
    RA_UP ();         // up   
	wait(w_rstick);             
	RA_L_R ();       // <-/->   
	wait(w_rstick);             
    Get_LS_Output = TRUE;
}                            
