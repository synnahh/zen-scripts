int AIM_X;
int AIM_Y;
function INSIDE_BOX_AIM(f_LX, f_LY) {     
 if(get_ival(PS4_LX) >= 12) AIM_X = f_LX ; 
 else if(get_ival(PS4_LX) <= -12)  AIM_X = inv(f_LX) ;  
               
 if(get_ival(PS4_LY) >= 12) AIM_Y = f_LY ;  
 else if(get_ival( PS4_LY) <= -12) AIM_Y = inv(f_LY);
}  
int flick_up; 
int flick_d;  
int flick_l;  
int flick_r; 
int RS_Sens  = 50

// --- Right Stick Skills
function f_RightStickMove () {
    //  Right Stick -->  UP
       if( get_ival(PS4_RY) < -70  && !flick_up ) {
       		 flick_up = TRUE;
               right_on = FALSE;
       	  ACTIVE = SKILL_UP;   //
            run_skill_combo(SKILL_UP);
       }
       //  Right Stick -->  DOWN
       if( get_ival(PS4_RY) >  70  && !flick_d ) {
       		flick_d = TRUE;
       		right_on = TRUE;
       	  ACTIVE = SKILL_DOWN; //
            run_skill_combo(SKILL_DOWN);
       }

       //  Right Stick --> LEFT
       if( get_ival(PS4_RX) < -70  && !flick_l ) {
               flick_l = TRUE;
               right_on = FALSE;
                ACTIVE = SKILL_LEFT;//
               run_skill_combo(SKILL_LEFT);
       }

       // Right Stick --> RIGHT
       if( get_ival(PS4_RX) >  70  && !flick_r ) {
               flick_r = TRUE;
               right_on = TRUE;
               ACTIVE = SKILL_RIGHT;//
              run_skill_combo(SKILL_RIGHT);
       }
       //------------------------------------------------------
       if(abs(get_ival(PS4_RY))<20  && abs(get_ival(PS4_RX))<20){
          flick_up = 0;
          flick_d  = 0;
          flick_l  = 0;
          flick_r  = 0;
       }
}
function run_skill_combo( f_skill){
//-----------------------------------------------------------------------
//-----
if(f_skill == FAKE_SHOT_SKILL)           { combo_run(FAKE_SHOT); Get_LS_Output = FALSE;}   // 1.
if(f_skill == HEEL_TO_HEEL_FLICK_SKILL  ){ combo_run(HEELtoHEEL); Get_LS_Output = FALSE;} //  2. Heel to Heel
if(f_skill == HEEL_FLICK_TURN_SKILL     ){ combo_run(HEELtoHEEL); Get_LS_Output = FALSE;} //  3. Heel FLICK TURN
if(f_skill == RAINBOW_SKILL             ){ combo_run(RAINBOW);  Get_LS_Output = FALSE;}   //  4. RAINBOW
if(f_skill == 5){Sombrero = TRUE; combo_run(DRAG_BACK); Get_LS_Output = FALSE;}            //  5. Drag Back Sombrero
if(f_skill == FAKE_PASS_SKILL           ){ combo_run(FAKE_SHOT); Get_LS_Output = FALSE;}   //  6. FAKE PASS (RT)
if(f_skill == 7){Sombrero = FALSE; combo_run(DRAG_BACK);   Get_LS_Output = FALSE;}         //  7. Drag Back Universal
if(f_skill == STEP_OVER_FEINT_SKILL     ){ combo_run(STEP_OVER_FEINT); Get_LS_Output = FALSE;} //  8. Step Over Feint
if(f_skill == DRAG_TO_DRAG_SKILL        ){ combo_run(DRAG_TO_DRAG); Get_LS_Output = FALSE;}   //  9. Fake Shot +  L2 + LS zero
if(f_skill == HOCUS_POCUS_SKILL         ){ combo_run(HOCUS_POCUS); Get_LS_Output = FALSE;}    // 10. Hocus Pocus
if(f_skill == TRIPLE_ELASTICO_SKILL     ){ combo_run(TRIPLE_ELASTICO); Get_LS_Output = FALSE;}// 11. TRIPLE_ELASTICO_SKILL
if(f_skill == ELASTICO_SKILL)            { combo_run(ELASTICO);  Get_LS_Output = FALSE;}      // 12. ELASTICO_SKILL
if(f_skill == REVERSE_ELASTICO_SKILL    ){ combo_run(REVERSE_ELASTICO); Get_LS_Output = FALSE;}// 13. REVERSE_ELASTICO_SKILL
if(f_skill == CRUYFF_TURN_SKILL         ){ combo_run(CRUYFF_TURN); Get_LS_Output = FALSE;}     // 14. CRUYFF_TURN_SKILL
if(f_skill == LA_CROQUETA_SKILL         ){ combo_run(LA_CROQUETA); Get_LS_Output = FALSE;}     // 15. La Croqueta
if(f_skill == RONALDO_CHOP_SKILL        ){ combo_run(FAKE_SHOT); Get_LS_Output = FALSE;}       // 16. RONALDO_CHOP_SKILL
if(f_skill == ROULETTE_SKILL)            { combo_run(ROULETTE); Get_LS_Output = FALSE;}        // 17. ROULETTE_SKILL
if(f_skill == FLAIR_ROULETTE_SKILL      ){ combo_run(ROULETTE); Get_LS_Output = FALSE;}        // 18. FLAIR_ROULETTE_SKILL
if(f_skill == BALL_ROLL_SKILL           ){ combo_run(BALL_ROLL); Get_LS_Output = FALSE;}       // 19. BALL_ROLL_SKILL
if(f_skill == BERBA_MCGEADY_SPIN_SKILL  ){ combo_run(TURN_AND_SPIN); Get_LS_Output = FALSE;}// 20. BERBA_MCGEADY_SPIN_SKILL
if(f_skill == BOLASIE_FLICK_SKILL       ){ combo_run(TURN_AND_SPIN); Get_LS_Output = FALSE;}   // 21. BOLASIE_FLICK_SKILL
if(f_skill == TORNADO_SKILL             ){ combo_run(TORNADO_SPIN);  Get_LS_Output = FALSE;}   // 22. TORNADO_SKILL
if(f_skill == THREE_TOUCH_ROULETTE_SKILL){ combo_run(TORNADO_SPIN); Get_LS_Output = FALSE;}// 23. THREE_TOUCH_ROULETTE_SKILL
if(f_skill == ALTERNATIVE_ELASTICO_CHOP_SKILL){ combo_run(TORNADO_SPIN); Get_LS_Output = FALSE;} // 24. ALTERNATIVE_ELASTICO_CHOP_SKILL R1
if(f_skill == BALL_ROLL_CHOP_SKILL){  combo_run(BALL_ROLL_CHOP); Get_LS_Output = FALSE;}   // 25. BALL_ROLL_CHOP_SKILL
if(f_skill == FEINT_AND_EXIT_SKILL){  combo_run(FEINT_EXIT);  Get_LS_Output = FALSE;}      // 26. FEINT_AND_EXIT_SKILL
if(f_skill == FEINT_L_EXIT_R_SKILL){  combo_run(FEINT_EXIT);  Get_LS_Output = FALSE;}      // 27. FEINT_L_EXIT_R_SKILL
if(f_skill == LATERAL_HEEL_TO_HEEL_SKILL){  combo_run(LATERAL_HEELtoHEEL); Get_LS_Output = FALSE;}  // 28. LATERAL_HEEL_TO_HEEL_SKILL
if(f_skill == WAKA_WAKA_SKILL            ){  combo_run(WAKA_WAKA); Get_LS_Output = FALSE;}            // 29. WAKA WAKA
if(f_skill == BODY_FEINT_SKILL           ){  combo_run(BODY_FEINT); Get_LS_Output = FALSE;}           // 30. BODY FEINT
if(f_skill == DRAG_TO_HEEL               ){  combo_run(TORNADO_SPIN); Get_LS_Output = FALSE;}            // 31. Drag to Heel move + L1
if(f_skill == BALL_ROLL_FAKE_TURN        ){    combo_run(TURN_AND_SPIN); Get_LS_Output = FALSE;}  // 32. Ball Roll Fake Turn + L2
if(f_skill == FEINT_FORWARD_AND_TURN     ){  combo_run(FEINT_FORWARD); Get_LS_Output = FALSE;} // 33. Feint Forward & Turn
if(f_skill == TURN_BACK                  ){  combo_run(TURN_BACK);  Get_LS_Output = FALSE;}                 // 34. Turn Back
if(f_skill == ADVANCED_CROQUETA          ){  combo_run(ADVANCED_CROQUETA); Get_LS_Output = FALSE;}  // 35. Advanced Croqueta 
if(f_skill == CANCELED_THREE_TOUCH_ROULETTE_SKILL ){  combo_run(CANCELED_THREE_TOUCH_ROULETTE); Get_LS_Output = FALSE;}  // 36 Canceled Three Touch Roulette
if(f_skill == REVERSE_STEP_OVER_SKILL    ){  combo_run(REVERSE_STEP_OVER); Get_LS_Output = FALSE;}   // 37. Reverse Step Over
if(f_skill == FAKE_DRAG_BACK_SKILL       ){  combo_run(FAKE_DRAG_BACK); Get_LS_Output = FALSE;}   // 38. Fake Drag Back
if(f_skill == RAINBOW_TO_SCORPION_KICK_SKILL  ){  combo_run(RAINBOW_TO_SCORPION); Get_LS_Output = FALSE;}//39
if(f_skill == STEP_OVER_BOOST_SKILL      ){  combo_run(BOOSTED_STEPOVER); Get_LS_Output = FALSE;}// 40
if(f_skill == CANCEL_SHOOT_SKILL         ){  combo_run(CANCEL_SHOOT);  Get_LS_Output = FALSE;}       // 41
if(f_skill == DIRECTIONAL_NUTMEG_SKILL   ){  combo_run(NUTMEG_SKILL);  Get_LS_Output = FALSE;} // 42 
if(f_skill == CANCELED_BERBA_SPIN_SKILL  ){   combo_run(CANCELED_TURN_AND_SPIN); Get_LS_Output = FALSE;}// 43 
if(f_skill == CANCELED_BERBA_SPIN_WITH_DIRECTION){  combo_run(CANCELED_TURN_AND_SPIN); Get_LS_Output = FALSE;}// 44 
if(f_skill == BALL_ROLL_TO_SCOOP_TURN_SKILL){  combo_run(BALL_ROLL_SCOOP_TURN); Get_LS_Output = FALSE;}// 45 
if(f_skill == DRIBBLING_SKILL            ){start = TRUE; combo_run(DRIBBLING_SKILL_cmb); Get_LS_Output = FALSE;}// 46
