int ShootPower;
int Power_Shot_Button = PS4_R3;
int PowerShotPing = 0;
// FC26: Low Driven Power Shot. Same L1+R1+Shot power shot input,
// finished with a charge -> release -> quick re-tap (Low Driven) instead of a
// precision-timed release, since FC26 removed Timed Finishing.
// NOTE: no aim assist here - left stick is left completely alone now. It used to
// snap the shot toward whatever tiny direction the stick drifted to mid-animation,
// which made shots fly to random sides. Removed entirely per user request.
combo TIMED_PS_FULL_POWER_cmb {
  if(ps_ping){ PowerShotPing = EA_Ping;}
  else { PowerShotPing = 0 }
  set_val(ShotBtn    ,100);
  POWER_SHOT_AIM();
  wait(ps_power);
  POWER_SHOT_AIM();
  wait(710) // Animation + AimLock (1)
  set_val(ShotBtn    ,100); // Timed _ Shot
  POWER_SHOT_AIM();
  wait(ps_accuracy + PowerShotPing);
  POWER_SHOT_AIM();
  wait(360) // Animation + AimLock (2)	
}
    
function POWER_SHOT_AIM() { 
  set_val(PlayerRun  ,100);
  set_val(FinesseShot,100);
	set_val(SprintBtn      ,0);   // Prevent unexcepected shot cancel
	set_val(PaceCtrol    ,100); // ADD More Accurcey
 }  
int TimedFinish_Ping = 0;
int tf_start_btn;
int QT_TimedFinish = TRUE;
// FC26: Low Driven Shot (full-power variant). Hold Shot for tf_power ms to
// charge, release, then re-tap after tf_accuracy ms (the double-tap gap)
// to keep it low & driven. Replaces FC25's timed-release finishing.
combo TIMED_FINISH_FULL_cmb { 
    if(tf_ping ){ TimedFinish_Ping = EA_Ping; }
    else { TimedFinish_Ping = 0; }
    set_val(ShotBtn,100);  
    wait(tf_power ); 
    LA(AIM_X,AIM_Y);
    set_val(ShotBtn,  0);  
    wait(tf_accuracy + TimedFinish_Ping);
    LA(AIM_X,AIM_Y);
    set_val(ShotBtn,100);  
    wait(tf_power);
    LA(AIM_X,AIM_Y);
    set_val(ShotBtn,  0);  
    wait(100); 
} 
combo TimedFinish_cmb { 
    if(tf_ping ){ TimedFinish_Ping = EA_Ping; }
    else { TimedFinish_Ping = 0; }
    set_val(ShotBtn, 0);             
    wait(tf_accuracy + TimedFinish_Ping );       
    set_val(ShotBtn, 100);            
    wait(tf_power);  
    set_val(ShotBtn, 0);              
    wait(1000);                      
}     

int TFF_Ping = 0;
int tff_start_btn;					
// FC26: Low Driven Finesse Shot (full-power variant) - same charge/release/
// double-tap pattern as the regular Low Driven Shot, layered on Finesse.
combo TFF_FULL_POWER_cmb { 
    if( tff_ping ){ TFF_Ping = EA_Ping; }
    else { TFF_Ping = 0; }
