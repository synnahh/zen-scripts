define UP         = 0;  
define UP_RIGHT   = 1;   
define RIGHT      = 2;                                                                                                                                                                                                                                                                                                                                                                                                                                       //syn
define DOWN_RIGHT = 3;  
define DOWN       = 4;  
define DOWN_LEFT  = 5;  
define LEFT       = 6;  
define UP_LEFT    = 7;  
int dEnd;
                                               
int ACTIVE;                                     
int SKILL ;  
int LX, LY;          // Direction of Left Stick         
int right_on ;                            
int w_rstick  = 50;                        
int OnOffMods = TRUE;                            
int Sombrero;     
int hold_btn = 200;
int Get_LS_Output = TRUE;
int Trivela_Ping = 0;
// FC26: Low Driven Trivela (full-power variant). Trivela input itself is
// unchanged (hold L2 + Shot) - only the finish is now a double-tap instead
// of a timed release. Remember: FC26 requires the Gamechanger PlayStyle for
// the trivela to actually come out in-game, otherwise it's a normal lace shot.
combo TTRIVELA_FULL_POWER_cmb { 
    if( t_trivela_ping ) { Trivela_Ping = EA_Ping; }
    else { Trivela_Ping = 0; }
    set_val(PaceCtrol,100);
    set_val(ShotBtn,100);  
    wait(t_trivela_power); 
    set_val(PaceCtrol,100);
    set_val(ShotBtn,  0);  
    wait(t_trivela_accuracy + Trivela_Ping);
    set_val(PaceCtrol,100);
    set_val(ShotBtn,100);  
