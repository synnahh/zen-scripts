// Ball Roll                   
combo BALL_ROLL {               
    RA_L_R () ;    // Left or Right 
    set_val(SprintBtn,0);
    sensitivity(PS4_LX, 50, 40);
    sensitivity(PS4_LY, 60, 40);
    wait(310); 
    sensitivity(PS4_LX, 50, 150);
    wait(100);     
    Get_LS_Output = TRUE;
}          
