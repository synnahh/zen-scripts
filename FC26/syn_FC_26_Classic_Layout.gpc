// FC26: Perfect Power Finesse Shot - R1 + Shot, single press/release, NOT low driven.
// Holds Shot for tff_power ms (same "LDF Power" value you can already tune in the
// edit menu) then releases once - a clean, consistently-powered finesse shot with
// no double-tap involved.
combo PERFECT_FINESSE_SHOT_cmb {
    set_val(FinesseShot,100);
    set_val(ShotBtn,100);
    wait(tff_power);
    set_val(FinesseShot,100);
    set_val(ShotBtn,0);
    wait(300);
}
